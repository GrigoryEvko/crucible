{
  "version": 11,
  "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "GCC 16.2.1 patched (contracts consteval-cache fix) + libstdc++ 16 (C++26)",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "_comment_toolchain": "Patched GCC 16.2.1 + libstdc++ 16 are resolved by cmake/Toolchain-gcc16.cmake. Override the location WITHOUT editing this file: set CRUCIBLE_GCC16_PREFIX=<install-prefix> (binaries at <prefix>/usr/bin/g++-16p, libs at <prefix>/usr/lib64), or CRUCIBLE_CXX=<full-g++-path>. Unset -> falls back to $HOME/.local/gcc16-patched (the canonical dev-box default, so this preset configures verbatim here). The libstdc++ rpath is derived from the same prefix.",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-gcc16.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CRUCIBLE_BENCH": "OFF",
        "CRUCIBLE_WERROR": "ON"
      },
      "vendor": { "crucible": { "tier": "gate", "configuration": "x86_64-debug-asan" } }
    },
    {
      "name": "analyzer",
      "inherits": "default",
      "displayName": "GCC 16 + -fanalyzer (observational)",
      "binaryDir": "${sourceDir}/build-analyzer",
      "cacheVariables": {
        "CRUCIBLE_ANALYZER": "ON",
        "CRUCIBLE_SANITIZE": "OFF",
        "CRUCIBLE_TSAN": "OFF",
        "CRUCIBLE_BENCH": "OFF",
        "CRUCIBLE_WERROR": "OFF"
      },
      "vendor": { "crucible": { "tier": "nightly" } }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O1 -march=native -DNDEBUG -g"
      },
      "vendor": { "crucible": { "tier": "gate", "configuration": "x86_64-release" } }
    },
    {
      "name": "bench",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Bench)",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "CRUCIBLE_BENCH": "ON"
      },
      "vendor": { "crucible": { "tier": "nightly" } }
    },
    {
      "name": "vessel",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release) with the patched PyTorch: the vessel libraries and the vessel tests",
      "binaryDir": "${sourceDir}/build-vessel",
      "cacheVariables": {
        "_comment_torch": "TORCH_DIR is the site-packages directory of the virtual environment .venv-torch of the source root, which holds the wheel of the patched PyTorch. CRUCIBLE_REQUIRE_VESSEL stops the configure step when the build cannot compile and test the vessel",
        "TORCH_DIR": "${sourceDir}/.venv-torch/lib/python3.14/site-packages",
        "CRUCIBLE_REQUIRE_VESSEL": "ON"
      },
      "vendor": { "crucible": { "tier": "nightly", "configuration": "x86_64-release-vessel" } }
    },
    {
      "name": "pgo-generate",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release, PGO instrumented)",
      "binaryDir": "${sourceDir}/build-pgo-generate",
      "cacheVariables": {
        "CRUCIBLE_PGO": "generate",
        "CRUCIBLE_BENCH": "ON"
      },
      "vendor": { "crucible": { "tier": "manual", "reason": "The step pgo of the release entry configures this build, builds its benches and runs them. A test run in this build adds counters to the profile. No entry runs its tests" } }
    },
    {
      "name": "pgo",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release, PGO applied)",
      "binaryDir": "${sourceDir}/build-pgo",
      "cacheVariables": {
        "CRUCIBLE_PGO": "use",
        "CRUCIBLE_BENCH": "ON"
      },
      "vendor": { "crucible": { "tier": "release" } }
    },
    {
      "name": "pgo-release",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release, PGO applied, release conditions)",
      "binaryDir": "${sourceDir}/build-pgo-release",
      "cacheVariables": {
        "CRUCIBLE_PGO": "use",
        "CRUCIBLE_PGO_STRICT": "ON",
        "CRUCIBLE_BENCH": "OFF"
      },
      "vendor": { "crucible": { "tier": "release" } }
    },
    {
      "name": "tsan",
      "inherits": "default",
      "displayName": "GCC 16 + ThreadSanitizer (AxRaceFree)",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CRUCIBLE_SANITIZE": "OFF",
        "CRUCIBLE_TSAN": "ON"
      },
      "vendor": { "crucible": { "tier": "gate", "configuration": "x86_64-debug-tsan" } }
    },
    {
      "name": "syntax-x86-64-v3",
      "inherits": "default",
      "displayName": "GCC 16, -march=x86-64-v3, parse only: the AVX2 arms for the quarantine ledgers (loop syntax)",
      "binaryDir": "${sourceDir}/build-syntax-x86-64-v3",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-march=x86-64-v3",
        "CRUCIBLE_SYNTAX_ONLY": "ON"
      },
      "vendor": { "crucible": { "tier": "gate", "configuration": "x86_64-debug-asan-syntax" } }
    },
    {
      "name": "syntax-aarch64",
      "inherits": "default",
      "displayName": "Cross GCC 16 for aarch64, parse only: the aarch64 arms for the quarantine ledgers (loop syntax)",
      "binaryDir": "${sourceDir}/build-syntax-aarch64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-gcc16-aarch64.cmake",
        "_comment_bpf": "include/crucible/perf/bpf/vmlinux.h holds the kernel types of x86_64, and clang cannot compile a BPF program of aarch64 with it",
        "CRUCIBLE_HAVE_BPF": "OFF",
        "CRUCIBLE_SYNTAX_ONLY": "ON"
      },
      "vendor": { "crucible": { "tier": "gate", "configuration": "aarch64-debug-asan-syntax" } }
    },
    {
      "name": "aarch64",
      "inherits": "default",
      "displayName": "Cross GCC 16 for aarch64 with no sanitizer: the release entry runs the tests under qemu-user",
      "binaryDir": "${sourceDir}/build-aarch64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-gcc16-aarch64.cmake",
        "_comment_sanitizers": "The cross install of the patched GCC has no libasan, libubsan or libtsan for aarch64. The build then links no sanitizer runtime",
        "_comment_bpf": "include/crucible/perf/bpf/vmlinux.h holds the kernel types of x86_64, and clang cannot compile a BPF program of aarch64 with it",
        "CRUCIBLE_SANITIZE": "OFF",
        "CRUCIBLE_TSAN": "OFF",
        "CRUCIBLE_HAVE_BPF": "OFF"
      },
      "vendor": { "crucible": { "tier": "release" } }
    },
    {
      "name": "no-bpf",
      "inherits": "default",
      "displayName": "GCC 16 + ASan with no BPF substrate: the build of a host with no libbpf, BPF clang or xxd",
      "binaryDir": "${sourceDir}/build-no-bpf",
      "cacheVariables": {
        "_comment_bpf": "With CRUCIBLE_HAVE_BPF off, crucible_perf holds only the Senses aggregate, and each load attaches nothing. The build links each target, so a direct call of a facade member outside an arm of CRUCIBLE_HAVE_BPF stops its link",
        "CRUCIBLE_HAVE_BPF": "OFF"
      },
      "vendor": { "crucible": { "tier": "nightly" } }
    },
    {
      "name": "ubsan-strict",
      "inherits": "default",
      "displayName": "GCC 16 + full UBSan on every target, signed overflow undefined",
      "binaryDir": "${sourceDir}/build-ubsan-strict",
      "cacheVariables": {
        "CRUCIBLE_SANITIZE": "OFF",
        "CRUCIBLE_TSAN": "OFF",
        "CRUCIBLE_UBSAN_STRICT": "ON"
      },
      "vendor": { "crucible": { "tier": "gate", "configuration": "x86_64-debug-ubsan-strict" } }
    },
    {
      "name": "bench-fuzz",
      "inherits": "default",
      "displayName": "GCC 16 + ASan, with the benches and the fuzz harnesses",
      "binaryDir": "${sourceDir}/build-bench-fuzz",
      "cacheVariables": {
        "CRUCIBLE_BENCH": "ON",
        "CRUCIBLE_FUZZ": "ON"
      },
      "vendor": { "crucible": { "tier": "gate", "configuration": "x86_64-debug-asan-bench-fuzz" } }
    },
    {
      "name": "verify",
      "inherits": "release",
      "displayName": "GCC 16 Release code generation with the contract families armed",
      "binaryDir": "${sourceDir}/build-verify",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-O1 -march=native -g",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3",
        "CRUCIBLE_VERIFY": "ON"
      },
      "vendor": { "crucible": { "tier": "nightly" } }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "analyzer", "configurePreset": "analyzer" },
    { "name": "release", "configurePreset": "release" },
    { "name": "bench",   "configurePreset": "bench" },
    { "name": "vessel",  "configurePreset": "vessel" },
    { "name": "pgo-generate", "configurePreset": "pgo-generate" },
    { "name": "pgo",     "configurePreset": "pgo" },
    { "name": "pgo-release", "configurePreset": "pgo-release" },
    { "name": "tsan",    "configurePreset": "tsan" },
    { "name": "no-bpf", "configurePreset": "no-bpf" },
    { "name": "ubsan-strict", "configurePreset": "ubsan-strict" },
    { "name": "bench-fuzz", "configurePreset": "bench-fuzz" },
    { "name": "verify",  "configurePreset": "verify" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "vessel",
      "configurePreset": "vessel",
      "displayName": "The tests of the build with the patched PyTorch, with no test of a counted ledger that only the gate lowers",
      "vendor": { "crucible": { "tier": "nightly" } },
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "name": "^guard_(plugin|artifacts)$" } },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "pgo",
      "configurePreset": "pgo",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "pgo-release",
      "configurePreset": "pgo-release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "analyzer",
      "configurePreset": "analyzer",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 600 }
    },
    {
      "name": "no-bpf",
      "configurePreset": "no-bpf",
      "displayName": "The tests of the build with no BPF substrate, with no ledger rule whose base rows count the BPF facades",
      "vendor": { "crucible": { "tier": "nightly" } },
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "name": "^guard_(plugin|artifact_symbols|artifacts)$" } },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "aarch64",
      "configurePreset": "aarch64",
      "displayName": "The tests of the aarch64 build under qemu-user, with no guard: the rows of an aarch64 configuration come from the log of its CI leg",
      "vendor": { "crucible": { "tier": "release" } },
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "ci_guard" } },
      "execution": { "jobs": "", "timeout": 900 }
    },
    {
      "name": "ubsan-strict",
      "configurePreset": "ubsan-strict",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 600 }
    },
    {
      "name": "bench-fuzz",
      "configurePreset": "bench-fuzz",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "verify",
      "configurePreset": "verify",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": "", "timeout": 300 }
    },
    {
      "name": "stress",
      "configurePreset": "default",
      "displayName": "Repeat-until-fail ×50 (race condition detector)",
      "vendor": { "crucible": { "tier": "nightly" } },
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": "",
        "timeout": 300,
        "repeat": { "mode": "until-fail", "count": 50 }
      }
    }
  ]
}
