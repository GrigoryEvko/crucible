{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "GCC 16.2.1 patched (contracts consteval-cache fix) + libstdc++ 16 (C++26)",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "_comment_toolchain": "Patched GCC 16.2.1 + libstdc++ 16 are resolved by cmake/Toolchain-gcc16.cmake. Override the location WITHOUT editing this file: set CRUCIBLE_GCC16_PREFIX=<install-prefix> (binaries at <prefix>/usr/bin/g++-16p, libs at <prefix>/usr/lib64), or CRUCIBLE_CXX=<full-g++-path>. Unset -> falls back to $HOME/.local/gcc16-patched (the canonical dev-box default, so this preset configures verbatim here). The libstdc++ rpath is derived from the same prefix.",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/Toolchain-gcc16.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CRUCIBLE_BENCH": "OFF",
        "CRUCIBLE_WERROR": "ON"
      }
    },
    {
      "name": "analyzer",
      "inherits": "default",
      "displayName": "GCC 16 + -fanalyzer (observational)",
      "binaryDir": "${sourceDir}/build-analyzer",
      "cacheVariables": {
        "CRUCIBLE_ANALYZER": "ON",
        "CRUCIBLE_SANITIZE": "OFF",
        "CRUCIBLE_TSAN": "OFF",
        "CRUCIBLE_BENCH": "OFF",
        "CRUCIBLE_WERROR": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O1 -march=native -DNDEBUG -g"
      }
    },
    {
      "name": "bench",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Bench)",
      "binaryDir": "${sourceDir}/build-bench",
      "cacheVariables": {
        "CRUCIBLE_BENCH": "ON"
      }
    },
    {
      "name": "pgo-generate",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release, PGO instrumented)",
      "binaryDir": "${sourceDir}/build-pgo-generate",
      "cacheVariables": {
        "CRUCIBLE_PGO": "generate",
        "CRUCIBLE_BENCH": "ON"
      }
    },
    {
      "name": "pgo",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release, PGO applied)",
      "binaryDir": "${sourceDir}/build-pgo",
      "cacheVariables": {
        "CRUCIBLE_PGO": "use",
        "CRUCIBLE_BENCH": "ON"
      }
    },
    {
      "name": "pgo-release",
      "inherits": "release",
      "displayName": "GCC 16 + libstdc++ 16 (C++26, Release, PGO applied, release conditions)",
      "binaryDir": "${sourceDir}/build-pgo-release",
      "cacheVariables": {
        "CRUCIBLE_PGO": "use",
        "CRUCIBLE_PGO_STRICT": "ON",
        "CRUCIBLE_BENCH": "OFF"
      }
    },
    {
      "name": "tsan",
      "inherits": "default",
      "displayName": "GCC 16 + ThreadSanitizer (AxRaceFree)",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CRUCIBLE_SANITIZE": "OFF",
        "CRUCIBLE_TSAN": "ON"
      }
    },
    {
      "name": "ubsan-strict",
      "inherits": "default",
      "displayName": "GCC 16 + full UBSan on every target, signed overflow undefined",
      "binaryDir": "${sourceDir}/build-ubsan-strict",
      "cacheVariables": {
        "CRUCIBLE_SANITIZE": "OFF",
        "CRUCIBLE_TSAN": "OFF",
        "CRUCIBLE_UBSAN_STRICT": "ON"
      }
    },
    {
      "name": "verify",
      "inherits": "release",
      "displayName": "GCC 16 Release code generation with the contract families armed",
      "binaryDir": "${sourceDir}/build-verify",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-O1 -march=native -g",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3",
        "CRUCIBLE_VERIFY": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "jobs": 192 },
    { "name": "analyzer", "configurePreset": "analyzer", "jobs": 192 },
    { "name": "release", "configurePreset": "release", "jobs": 192 },
    { "name": "bench",   "configurePreset": "bench", "jobs": 192 },
    { "name": "pgo-generate", "configurePreset": "pgo-generate", "jobs": 192 },
    { "name": "pgo",     "configurePreset": "pgo",   "jobs": 192 },
    { "name": "pgo-release", "configurePreset": "pgo-release", "jobs": 192 },
    { "name": "tsan",    "configurePreset": "tsan", "jobs": 192 },
    { "name": "ubsan-strict", "configurePreset": "ubsan-strict", "jobs": 192 },
    { "name": "verify",  "configurePreset": "verify", "jobs": 192 }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 300 }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 300 }
    },
    {
      "name": "pgo",
      "configurePreset": "pgo",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 300 }
    },
    {
      "name": "pgo-release",
      "configurePreset": "pgo-release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 300 }
    },
    {
      "name": "analyzer",
      "configurePreset": "analyzer",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 300 }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 600 }
    },
    {
      "name": "ubsan-strict",
      "configurePreset": "ubsan-strict",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 600 }
    },
    {
      "name": "verify",
      "configurePreset": "verify",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 192, "timeout": 300 }
    },
    {
      "name": "stress",
      "configurePreset": "default",
      "displayName": "Repeat-until-fail ×50 (race condition detector)",
      "output": { "outputOnFailure": true },
      "execution": {
        "jobs": 192,
        "timeout": 300,
        "repeat": { "mode": "until-fail", "count": 50 }
      }
    }
  ]
}
