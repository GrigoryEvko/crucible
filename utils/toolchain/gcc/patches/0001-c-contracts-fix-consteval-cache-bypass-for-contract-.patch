From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Grigory Evko <grigory@evko.io>
Date: Mon, 25 May 2026 19:39:41 +0200
Subject: [PATCH 1/2] c++, contracts: fix consteval cache bypass for contract
 violations

Do not cache constexpr_call results when a contract violation occurred,
preventing false positives where violated contracts are silently ignored
on subsequent calls with cached results.

Cherry-picked from ac1cdcdad9d364f239d075deb7082071c49ddb6d.
---
 gcc/cp/constexpr.cc                               |  4 ++++
 .../contracts/cpp26/basic.contract.eval.p8-3.C    | 15 +++++++++++++++
 2 files changed, 19 insertions(+)
 create mode 100644 gcc/testsuite/g++.dg/contracts/cpp26/basic.contract.eval.p8-3.C

diff --git a/gcc/cp/constexpr.cc b/gcc/cp/constexpr.cc
index 5a28bd63c43..699d8b94584 100644
--- a/gcc/cp/constexpr.cc
+++ b/gcc/cp/constexpr.cc
@@ -4705,6 +4705,10 @@ cxx_eval_call_expression (const constexpr_ctx *ctx, tree t,
 	  /* Only cache a permitted result of a constant expression.  */
 	  if (cacheable && !reduced_constant_expression_p (result))
 	    cacheable = false;
+
+	  /* Only cache a result without contract violations.  */
+	  if (cacheable && ctx->global->contract_statement)
+	    cacheable = false;
 	}
       else
 	/* Couldn't get a function copy to evaluate.  */
diff --git a/gcc/testsuite/g++.dg/contracts/cpp26/basic.contract.eval.p8-3.C b/gcc/testsuite/g++.dg/contracts/cpp26/basic.contract.eval.p8-3.C
new file mode 100644
index 00000000000..e121d8b5790
--- /dev/null
+++ b/gcc/testsuite/g++.dg/contracts/cpp26/basic.contract.eval.p8-3.C
@@ -0,0 +1,15 @@
+// basic.contract.eval/p8
+// If a contract violation occurs in a context that is manifestly
+// constant-evaluated ([expr.const]), and the evaluation semantic is a
+// terminating semantic, the program is ill-formed.
+// { dg-do compile { target c++23 } }
+// { dg-additional-options "-fcontracts" }
+
+consteval auto foo( auto x ) pre( false ) { return x; }
+// { dg-error {contract predicate is false in constant expression} "" { target *-*-* } .-1 }
+
+static_assert(foo( 42 ) == 42, "");
+
+int main() {
+  foo( 42 ); // { dg-error {call to consteval function 'foo<int>\(42\)' is not a constant expression} }
+}
