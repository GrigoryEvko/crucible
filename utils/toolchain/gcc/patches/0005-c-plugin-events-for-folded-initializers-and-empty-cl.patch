+DEFEVENT (PLUGIN_EMPTY_CLASS_ASSIGNMENT)
+
 /* When adding a new hard-coded plugin event, don't forget to edit in
    file plugin.cc the functions register_callback and
    invoke_plugin_callbacks_full accordingly!  */
diff --git a/gcc/testsuite/g++.dg/plugin/empty-class-assignment-plugin-test.C b/gcc/testsuite/g++.dg/plugin/empty-class-assignment-plugin-test.C
new file mode 100644
index 0000000..77831e0
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/empty-class-assignment-plugin-test.C
@@ -0,0 +1,34 @@
+// Test the plugin event PLUGIN_EMPTY_CLASS_ASSIGNMENT: one event for each
+// trivial assignment of an empty class, also in a condition and at the
+// instantiation of a template, and no event for a class that is not empty or
+// for an assignment operator that the user provides.
+// { dg-do compile }
+
+struct tracked_empty {};
+struct tracked_full { int value; };
+struct tracked_user
+{
+  tracked_user &operator= (const tracked_user &) { return *this; }
+};
+
+tracked_empty make_empty ();
+
+bool
+use (tracked_empty first, tracked_full full, tracked_full other,
+     tracked_user user, tracked_user user_other)
+{
+  first = make_empty (); // { dg-warning "assignment to 'first' of the empty class 'tracked_empty'" }
+  bool done = ((first = tracked_empty ()), true); // { dg-warning "assignment to 'first' of the empty class 'tracked_empty'" }
+  full = other;
+  user = user_other;
+  return done;
+}
+
+template <class T>
+void
+pattern (T target, T source)
+{
+  target = source; // { dg-warning "assignment to 'target' of the empty class 'tracked_empty'" }
+}
+
+template void pattern<tracked_empty> (tracked_empty, tracked_empty);
diff --git a/gcc/testsuite/g++.dg/plugin/empty_class_assignment_plugin.cc b/gcc/testsuite/g++.dg/plugin/empty_class_assignment_plugin.cc
new file mode 100644
index 0000000..2bae7ec
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/empty_class_assignment_plugin.cc
@@ -0,0 +1,36 @@
+/* A plugin that gives a warning for each trivial assignment of an empty
+   class that PLUGIN_EMPTY_CLASS_ASSIGNMENT reports, with the target of the
+   assignment.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_empty_class_assignment (void *event_data, void *)
+{
+  plugin_empty_class_assignment_data *data
+    = (plugin_empty_class_assignment_data *) event_data;
+  location_t loc = linemap_resolve_location (line_table, data->location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  warning_at (loc, 0, "assignment to %qE of the empty class %qT", data->target,
+	      DECL_CONTEXT (data->fn));
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_EMPTY_CLASS_ASSIGNMENT,
+		     plugin_empty_class_assignment, NULL);
+  return 0;
+}
diff --git a/gcc/testsuite/g++.dg/plugin/folded-initializer-plugin-test.C b/gcc/testsuite/g++.dg/plugin/folded-initializer-plugin-test.C
new file mode 100644
index 0000000..8ac1a16
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/folded-initializer-plugin-test.C
@@ -0,0 +1,51 @@
+// Test the plugin event PLUGIN_FOLDED_INITIALIZER: one event for each
+// initializer that the front end replaces with its folded value, at each of
+// the four places, also at the instantiation of a template, and no event for
+// an initializer that stays.
+// { dg-do compile }
+// { dg-options "-std=c++20" }
+
+struct tracked_token
+{
+  constexpr tracked_token () noexcept = default;
+  constexpr tracked_token (tracked_token &&) noexcept {}
+};
+
+struct tracked_holder { tracked_token held; };
+
+struct tracked_owner
+{
+  constexpr explicit tracked_owner (tracked_token &&token) noexcept
+    : held (static_cast<tracked_token &&> (token)) {}
+  tracked_token held;
+};
+
+constexpr tracked_token
+tracked_pass (tracked_token &&token) noexcept
+{
+  return static_cast<tracked_token &&> (token);
+}
+
+int runtime_value ();
+
+int
+use ()
+{
+  tracked_token token;
+  tracked_token back = tracked_pass (static_cast<tracked_token &&> (token)); // { dg-warning "folded initializer of variable 'back': target_expr to constructor" }
+  tracked_holder holder { static_cast<tracked_token &&> (back) }; // { dg-warning "folded element: target_expr to constructor" }
+  tracked_owner owner (static_cast<tracked_token &&> (holder.held)); // { dg-warning "folded constructor call for 'owner': call_expr to constructor" }
+  tracked_token both[1] { static_cast<tracked_token &&> (owner.held) }; // { dg-warning "folded array element: expr_stmt to constructor" }
+  int kept = runtime_value ();
+  return kept;
+}
+
+template <class T>
+void
+pattern ()
+{
+  T value;
+  T moved = tracked_pass (static_cast<T &&> (value)); // { dg-warning "folded initializer of variable 'moved': target_expr to constructor" }
+}
+
+template void pattern<tracked_token> ();
diff --git a/gcc/testsuite/g++.dg/plugin/folded_initializer_plugin.cc b/gcc/testsuite/g++.dg/plugin/folded_initializer_plugin.cc
new file mode 100644
index 0000000..569143f
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/folded_initializer_plugin.cc
@@ -0,0 +1,53 @@
+/* A plugin that gives a warning for each initializer that
+   PLUGIN_FOLDED_INITIALIZER reports, with the kind of the fold, the object
+   and the tree codes before and after the fold.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_folded_initializer (void *event_data, void *)
+{
+  plugin_folded_initializer_data *data
+    = (plugin_folded_initializer_data *) event_data;
+  location_t loc = linemap_resolve_location (line_table, data->location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  const char *before = get_tree_code_name (TREE_CODE (data->original));
+  const char *after = get_tree_code_name (TREE_CODE (data->folded));
+  switch (data->kind)
+    {
+    case PLUGIN_FOLDED_VARIABLE:
+      warning_at (loc, 0, "folded initializer of variable %qD: %s to %s",
+		  data->object, before, after);
+      break;
+    case PLUGIN_FOLDED_CONSTRUCTOR_CALL:
+      warning_at (loc, 0, "folded constructor call for %qE: %s to %s",
+		  data->object, before, after);
+      break;
+    case PLUGIN_FOLDED_ELEMENT:
+      warning_at (loc, 0, "folded element: %s to %s", before, after);
+      break;
+    case PLUGIN_FOLDED_ARRAY_ELEMENT:
+      warning_at (loc, 0, "folded array element: %s to %s", before, after);
+      break;
+    }
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_FOLDED_INITIALIZER,
+		     plugin_folded_initializer, NULL);
+  return 0;
+}
