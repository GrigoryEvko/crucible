diff --git a/gcc/cp/cp-tree.h b/gcc/cp/cp-tree.h
index fc3cfc6..c4e1d74 100644
--- a/gcc/cp/cp-tree.h
+++ b/gcc/cp/cp-tree.h
@@ -8246,6 +8246,74 @@ struct plugin_reflection_data
   location_t location;
 };

+/* The kinds of the plugin event PLUGIN_FOLDED_INITIALIZER: the places
+   where the front end replaces an initializer with its folded value.  */
+
+enum plugin_folded_initializer_kind
+{
+  /* The initializer of a variable, in store_init_value.  */
+  PLUGIN_FOLDED_VARIABLE,
+  /* A call of a constexpr constructor that initializes an object, in
+     expand_default_init.  */
+  PLUGIN_FOLDED_CONSTRUCTOR_CALL,
+  /* An element of a braced initializer list, in massage_init_elt: an
+     element of an aggregate, of a compound literal or of the capture list
+     of a lambda.  */
+  PLUGIN_FOLDED_ELEMENT,
+  /* The initialization of an element of an array, in build_vec_init.  */
+  PLUGIN_FOLDED_ARRAY_ELEMENT
+};
+
+/* The data of the plugin event PLUGIN_FOLDED_INITIALIZER.  The front end
+   invokes the event each time that it replaces an initializer with a
+   different tree that a fold gives, also in a template and at the
+   instantiation of a template.  When the value of the initializer is a
+   constant, the fold drops each call, conversion and std::move in it, so
+   the semantic tree at PLUGIN_PRE_GENERICIZE does not hold them.  The event
+   gives the initializer before the fold.  */
+
+struct plugin_folded_initializer_data
+{
+  enum plugin_folded_initializer_kind kind;
+  /* The object that the initializer initializes: the VAR_DECL of a
+     variable, the expression of the object of a constructor call, or
+     NULL_TREE for an element.  */
+  tree object;
+  /* The initializer before the fold.  It can share a subtree with FOLDED,
+     and FOLDED can be a subtree of it, as when the fold drops a
+     TARGET_EXPR.  The fold can replace an operand of a shared subtree.  */
+  tree original;
+  /* The tree that replaces ORIGINAL.  The front end keeps this tree, as
+     the DECL_INITIAL of a variable, as the value of an INIT_EXPR or as an
+     element of a CONSTRUCTOR.  Only PLUGIN_FOLDED_VARIABLE can give a tree
+     that is not a constant.  store_init_value then moves the parts of it
+     that are not constant into statements (split_nonconstant_init).  */
+  tree folded;
+  /* The location of ORIGINAL, or of the object when ORIGINAL has none.  */
+  location_t location;
+};
+
+/* The data of the plugin event PLUGIN_EMPTY_CLASS_ASSIGNMENT.  The front
+   end invokes the event when it replaces a call of a trivial assignment
+   operator of an empty class with the COMPOUND_EXPR (SOURCE, TARGET).  In
+   an expression statement, convert_to_void then replaces TARGET with a
+   void constant, so the semantic tree does not hold the target of the
+   assignment.  */
+
+struct plugin_empty_class_assignment_data
+{
+  /* The object that the assignment assigns to.  */
+  tree target;
+  /* The right operand, after its conversion to the type of the parameter.
+     It stays in the tree as the first operand of the COMPOUND_EXPR.  */
+  tree source;
+  /* The FUNCTION_DECL of the trivial assignment operator.  */
+  tree fn;
+  /* input_location when the front end builds the replacement: the location
+     of the assignment.  */
+  location_t location;
+};
+
 /* in pt.cc */
 extern tree canonical_type_parameter		(tree);
 extern void push_access_scope			(tree);
diff --git a/gcc/cp/init.cc b/gcc/cp/init.cc
index 044435d..e3fc715 100644
