 static bool begin_init_stmts (tree *, tree *);
 static tree finish_init_stmts (bool, tree, tree);
@@ -2262,7 +2263,13 @@ expand_default_init (tree binfo, tree true_exp, tree exp, tree init, int flags,
 	{
 	  tree e = maybe_constant_init (rval, exp);
 	  if (TREE_CONSTANT (e))
-	    rval = cp_build_init_expr (exp, e);
+	    {
+	      plugin_folded_initializer_data data
+		= { PLUGIN_FOLDED_CONSTRUCTOR_CALL, exp, rval, e,
+		    cp_expr_loc_or_input_loc (rval) };
+	      invoke_plugin_callbacks (PLUGIN_FOLDED_INITIALIZER, &data);
+	      rval = cp_build_init_expr (exp, e);
+	    }
 	}
     }

@@ -5008,6 +5015,14 @@ build_vec_init (tree base, tree maxindex, tree init,
 	      tree e = maybe_constant_init (one_init);
 	      if (reduced_constant_expression_p (e))
 		{
+		  if (e != one_init)
+		    {
+		      plugin_folded_initializer_data data
+			= { PLUGIN_FOLDED_ARRAY_ELEMENT, NULL_TREE, one_init,
+			    e, cp_expr_loc_or_input_loc (one_init) };
+		      invoke_plugin_callbacks (PLUGIN_FOLDED_INITIALIZER,
+					       &data);
+		    }
 		  CONSTRUCTOR_APPEND_ELT (const_vec, field, e);
 		  if (do_static_init)
 		    one_init = NULL_TREE;
diff --git a/gcc/cp/typeck2.cc b/gcc/cp/typeck2.cc
index 155c2ac..0f5ab36 100644
--- a/gcc/cp/typeck2.cc
+++ b/gcc/cp/typeck2.cc
@@ -34,6 +34,7 @@ along with GCC; see the file COPYING3.  If not see
 #include "intl.h"
 #include "gcc-rich-location.h"
 #include "target.h"
+#include "plugin.h"

 static tree
 process_init_constructor (tree type, tree init, int nested, int flags,
@@ -967,6 +968,9 @@ store_init_value (tree decl, tree init, vec<tree, va_gc>** cleanups, int flags)

   current_ref_temp_count = 0;
   value = extend_ref_init_temps (decl, value, cleanups);
+  /* The initializer before the folds below, for the plugin event
+     PLUGIN_FOLDED_INITIALIZER.  */
+  tree unfolded = value;

   /* In C++11 constant expression is a semantic, not syntactic, property.
      In C++98, make sure that what we thought was a constant expression at
@@ -1038,6 +1042,15 @@ store_init_value (tree decl, tree init, vec<tree, va_gc>** cleanups, int flags)
       || TREE_STATIC (decl))
     value = cp_fully_fold_init (value);

+  if (value != unfolded && !error_operand_p (value)
+      && !error_operand_p (unfolded))
+    {
+      plugin_folded_initializer_data data
+	= { PLUGIN_FOLDED_VARIABLE, decl, unfolded, value,
+	    cp_expr_loc_or_loc (unfolded, DECL_SOURCE_LOCATION (decl)) };
+      invoke_plugin_callbacks (PLUGIN_FOLDED_INITIALIZER, &data);
+    }
+
   /* Handle aggregate NSDMI in non-constant initializers, too.  */
   value = replace_placeholders (value, decl);

@@ -1687,7 +1700,16 @@ massage_init_elt (tree type, tree init, int nested, int flags,
     {
       tree t = fold_non_dependent_init (init, complain);
       if (TREE_CONSTANT (t))
-	init = t;
+	{
+	  if (t != init)
+	    {
+	      plugin_folded_initializer_data data
+		= { PLUGIN_FOLDED_ELEMENT, NULL_TREE, init, t,
+		    cp_expr_loc_or_input_loc (init) };
+	      invoke_plugin_callbacks (PLUGIN_FOLDED_INITIALIZER, &data);
+	    }
+	  init = t;
+	}
       set_target_expr_eliding (init);
     }
   return init;
diff --git a/gcc/doc/plugins.texi b/gcc/doc/plugins.texi
index 7ed8516..f6081ee 100644
--- a/gcc/doc/plugins.texi
+++ b/gcc/doc/plugins.texi
@@ -235,6 +235,12 @@ enum plugin_event
   /* Called by the C++ front end after it parses a reflect-expression, and
      when it resolves a splice-specifier.  */
   PLUGIN_REFLECTION,
+  /* Called by the C++ front end when it replaces an initializer with the
+     tree that a fold gives.  */
+  PLUGIN_FOLDED_INITIALIZER,
+  /* Called by the C++ front end when it replaces a trivial assignment of an
+     empty class with its right operand.  */
+  PLUGIN_EMPTY_CLASS_ASSIGNMENT,

   PLUGIN_EVENT_FIRST_DYNAMIC    /* Dummy event used for indexing callback
                                    array.  */
@@ -380,6 +386,52 @@ see one reflection more than one time.  A name in the operand of a
 reflect-expression also gives the @i{PLUGIN_NAME_USE} event, so a plugin
 can tell a reflection of a name from a plain use of it.

+The @i{PLUGIN_FOLDED_INITIALIZER} event is triggered by the C++ front end
+each time that it replaces an initializer with a different tree that a fold
+gives, also in a template and at the instantiation of a template.  When the
+value of an initializer is a constant, the fold drops each call,
+conversion and @code{std::move} in it, so the tree at
+@i{PLUGIN_PRE_GENERICIZE} does not hold them.  This occurs, for example,
+for a call of a @code{constexpr} function that takes an empty class by
+reference.  The GCC data is a pointer to a
+@code{struct plugin_folded_initializer_data}, declared in
+@file{cp/cp-tree.h}.  Its field @code{kind} names the place of the fold:
+@code{PLUGIN_FOLDED_VARIABLE} for the initializer of a variable,
+@code{PLUGIN_FOLDED_CONSTRUCTOR_CALL} for a call of a @code{constexpr}
+constructor that initializes an object, @code{PLUGIN_FOLDED_ELEMENT} for
+an element of a braced initializer list (an aggregate, a compound literal
+or the capture list of a lambda), and @code{PLUGIN_FOLDED_ARRAY_ELEMENT}
+for the initialization of an element of an array.  Its field
+@code{object} is the variable, the expression of the object of the
+constructor call, or null for an element.  Its field @code{original} is
+the initializer before the fold, and its field @code{folded} is the tree
+that the front end keeps in its place: the @code{DECL_INITIAL} of a
+variable, the value of an @code{INIT_EXPR} or an element of a
+@code{CONSTRUCTOR}.  Only @code{PLUGIN_FOLDED_VARIABLE} can give a
+@code{folded} tree that is not a constant.  The front end then moves the
+parts of it that are not constant into statements.  The two trees can
+share a subtree, and @code{folded}
+can be a subtree of @code{original}, as when the fold drops a
+@code{TARGET_EXPR}.  The fold can also replace an operand of a shared
+subtree.  Its field @code{location} is the location of @code{original}.
+The front end collects no garbage between a fold in the body of a
+function and the @i{PLUGIN_PRE_GENERICIZE} event of that function, so a
+plugin can keep the two trees until that event.
+
+The @i{PLUGIN_EMPTY_CLASS_ASSIGNMENT} event is triggered by the C++ front
+end when it replaces a call of a trivial assignment operator of an empty
+class with the @code{COMPOUND_EXPR} of the right operand and the target,
+also at the instantiation of a template.  In an expression statement, the
+front end then replaces the target with a void constant, so the tree does
+not show which object the assignment assigns to.  The GCC data is a
+pointer to a @code{struct plugin_empty_class_assignment_data}, declared in
+@file{cp/cp-tree.h}.  Its field @code{target} is the object that the
+assignment assigns to, its field @code{source} is the right operand after
+its conversion to the type of the parameter, its field @code{fn} is the
+assignment operator, and its field @code{location} is the location of the
+assignment.  The source stays in the tree as the first operand of the
+@code{COMPOUND_EXPR}, so a plugin can find the place of the assignment.
+
 The @i{PLUGIN_NAME_USE} and @i{PLUGIN_MEMBER_ACCESS} events are direct
 events.  They occur very often, so the front end calls their callbacks
 itself, with the facts of the event as arguments, and not through
