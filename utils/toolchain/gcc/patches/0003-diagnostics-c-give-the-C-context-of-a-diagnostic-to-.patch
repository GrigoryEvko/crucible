+/* { dg-do compile { target c++20 } } */
+/* { dg-additional-options "-fdiagnostics-add-output=sarif" } */
+
+/* Verify that SARIF output holds the C++ context of a diagnostic: the
+   function, the instantiation, the constexpr calls and the constraints
+   before the diagnostic, and the macro expansions after it.  The text output
+   gets each diagnostic too, and each dg-message holds a context line of it.
+   The line numbers of this file are in context-lines-1.py.  */
+
+template<typename T> concept has_size = requires (T t) { t.size (); }; // { dg-message "required for the satisfaction of .has_size" }
+template<typename T> concept container = has_size<T>; // { dg-message "required for the satisfaction of .container" }
+template<container T> void use (T) {}
+
+void test_constraint ()
+{
+  use (42); // { dg-error "no matching function" }
+}
+
+template<typename T> struct holder
+{
+  T value;
+  void reset () { value = nullptr; } // { dg-error "cannot convert" }
+};
+
+void test_instantiation ()
+{
+  holder<int> h;
+  h.reset (); // { dg-message "required from here" }
+}
+
+constexpr int divide (int x) { return 1 / x; } // { dg-error "not a constant expression" }
+constexpr int bad = divide (0); // { dg-message "in .constexpr. expansion of" }
+
+#define ASSIGN(dst, src) dst = src // { dg-message "in definition of macro" }
+
+void test_macro ()
+{
+  int *p;
+  ASSIGN (p, 1.0); // { dg-error "cannot convert" }
+}
+
+/* { dg-final { verify-sarif-file } }
+   { dg-final { run-sarif-pytest context-lines-1.C "context-lines-1.py" } } */
