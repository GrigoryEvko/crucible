+/* Add the C++ context of DIAGNOSTIC to LINES for the sinks that are not
+   text sinks (diagnostics::context::set_context_lines_callback).  The lines
+   are the lines that cp_diagnostic_text_starter prints before the
+   diagnostic, and the macro expansion trace that
+   c_diagnostic_text_finalizer prints after it.  */
+
+static void
+cp_collect_context_lines (diagnostics::context &context,
+			  const diagnostics::diagnostic_info &diagnostic,
+			  pretty_printer &pp,
+			  diagnostics::context_lines &lines,
+			  bool update_state)
+{
+  cp_context_out out (context, pp, lines, update_state);
+  cp_print_error_function (out, &diagnostic);
+  maybe_print_instantiation_context (out);
+  maybe_print_constexpr_context (out);
+  maybe_print_constraint_context (out);
+  diagnostics::collect_expanded_macro_context
+    (context, diagnostic_location (&diagnostic), pp, lines);
+}
