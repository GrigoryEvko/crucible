@@ -0,0 +1,111 @@
+from sarif import *
+
+import pytest
+
+@pytest.fixture(scope='function', autouse=True)
+def sarif():
+    return sarif_from_env()
+
+expected_filename = 'context-lines-1.C'
+
+def context_lines(result):
+    """Return (kind, text, line) for each context line of RESULT."""
+    lines = []
+    for location in result.get('relatedLocations', []):
+        properties = location.get('properties', {})
+        if 'gcc/context' in properties:
+            region = location.get('physicalLocation', {}).get('region', {})
+            lines.append((properties['gcc/context'],
+                          location['message']['text'],
+                          region.get('startLine')))
+    return lines
+
+def context_owners(result):
+    """Return (gcc/contextOf, gcc/placement) for each context line of RESULT."""
+    return [(location['properties']['gcc/contextOf'],
+             location['properties']['gcc/placement'])
+            for location in result.get('relatedLocations', [])
+            if 'gcc/context' in location.get('properties', {})]
+
+def test_results(sarif):
+    results = sarif['runs'][0]['results']
+    assert len(results) == 4
+    for result in results:
+        assert result['level'] == 'error'
+        assert get_location_artifact_uri(result['locations'][0]).endswith(expected_filename)
+
+def test_constraint_context(sarif):
+    result = sarif['runs'][0]['results'][0]
+    assert 'no matching function' in result['message']['text']
+
+    # The region starts at 'use', and the text names the caret at '('.
+    assert result['locations'][0]['physicalLocation']['region']['startColumn'] == 3
+    text_location = result['properties']['gcc/textLocation']
+    assert text_location['file'].endswith(expected_filename)
+    assert text_location['line'] == 16
+    assert text_location['column'] == 7
+    lines = context_lines(result)
+    kinds = [kind for kind, _, _ in lines]
+    assert kinds == ['function', 'instantiation', 'instantiation-step',
+                     'constraint', 'constraint', 'constraint']
+    assert 'In function' in lines[0][1] and 'test_constraint' in lines[0][1]
+    assert lines[1][1].startswith('In substitution of')
+    assert lines[2][1] == 'required from here'
+    assert lines[2][2] == 16
+    step = [location for location in result['relatedLocations']
+            if location.get('properties', {}).get('gcc/context') == 'instantiation-step'][0]
+    assert step['properties']['gcc/textLocation']['line'] == 16
+    assert step['properties']['gcc/textLocation']['column'] == 7
+    assert lines[3][1].startswith('required for the satisfaction of')
+    assert 'has_size<T>' in lines[3][1] and '[with T = int]' in lines[3][1]
+    assert lines[4][1].startswith('required for the satisfaction of')
+    assert 'container<T>' in lines[4][1]
+    assert lines[5][1].startswith('in requirements with')
+
+    # Each nested diagnostic gives its kind, because a location object
+    # has no level.
+    nested = [location for location in result['relatedLocations']
+              if 'gcc/kind' in location.get('properties', {})]
+    assert nested
+    for location in nested:
+        assert location['properties']['gcc/kind'] == 'note'
+
+    # The function line belongs to the error itself.  The instantiation and
+    # constraint lines belong to the fifth nested diagnostic, the note on
+    # the invalid required expression, and the text prints them before it.
+    owners = context_owners(result)
+    assert owners[0] == (0, 'before')
+    assert owners[1:] == [(5, 'before')] * 5
+    assert 'the required expression' in nested[4]['message']['text']
+
+def test_constexpr_context(sarif):
+    result = sarif['runs'][0]['results'][1]
+    assert 'not a constant expression' in result['message']['text']
+    lines = context_lines(result)
+    assert [kind for kind, _, _ in lines] == ['function', 'constexpr']
+    assert lines[0][1] == 'At global scope:'
+    assert 'constexpr' in lines[1][1] and 'divide(0)' in lines[1][1]
+    assert lines[1][2] == 32
+
+def test_macro_context(sarif):
+    result = sarif['runs'][0]['results'][2]
+    assert 'cannot convert' in result['message']['text']
+    lines = context_lines(result)
+    assert [kind for kind, _, _ in lines] == ['function', 'macro']
+    assert 'test_macro' in lines[0][1]
+    assert lines[1][1].startswith('in definition of macro')
+    assert 'ASSIGN' in lines[1][1]
+    assert lines[1][2] == 34
+    # The text prints the macro trace after the error.
+    assert context_owners(result) == [(0, 'before'), (0, 'after')]
+
+def test_instantiation_context(sarif):
+    result = sarif['runs'][0]['results'][3]
+    assert 'cannot convert' in result['message']['text']
+    lines = context_lines(result)
+    assert [kind for kind, _, _ in lines] == ['instantiation',
+                                              'instantiation-step']
+    assert lines[0][1].startswith('In instantiation of')
+    assert 'holder<T>::reset()' in lines[0][1]
+    assert lines[1][1] == 'required from here'
+    assert lines[1][2] == 28
