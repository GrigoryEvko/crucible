+/* Where the C++ context of a diagnostic goes: the function, the template
+   instantiation, the constexpr calls and the constraints that hold the
+   diagnostic.  For a text sink, each printer of the context prints its
+   lines into the text sink.  For each other sink, each line goes into a
+   list of context lines, with no location prefix and no indentation
+   (diagnostics::context::set_context_lines_callback).  */
+
+class cp_context_out
+{
+public:
+  /* Print the context into TEXT_OUTPUT.  The printers change the state that
+     tells them which context to print, for example to print an
+     instantiation context only one time.  */
+  explicit cp_context_out (diagnostics::text_sink &text_output)
+  : m_text_output (&text_output),
+    m_context (text_output.get_context ()),
+    m_printer (nullptr),
+    m_lines (nullptr),
+    m_update_state (true),
+    m_kind (nullptr)
+  {}
+
+  /* Add the context to LINES, with PP to format each line.  The printers
+     change their state only when UPDATE_STATE is true.  */
+  cp_context_out (diagnostics::context &context, pretty_printer &pp,
+		  diagnostics::context_lines &lines, bool update_state)
+  : m_text_output (nullptr),
+    m_context (context),
+    m_printer (&pp),
+    m_lines (&lines),
+    m_update_state (update_state),
+    m_kind (nullptr)
+  {}
+
+  /* Return the text sink, or null when the lines go into a list.  */
+  diagnostics::text_sink *text_output () const { return m_text_output; }
+
+  diagnostics::context &get_context () const { return m_context; }
+
+  /* Return the printer that formats the current line.  */
+  pretty_printer *get_printer () const
+  {
+    return m_text_output ? m_text_output->get_printer () : m_printer;
+  }
+
+  bool update_state_p () const { return m_update_state; }
+
+  /* Set the kind of the lines that go into the list after this call.  */
+  void set_kind (const char *kind) { m_kind = kind; }
+
+  /* Start a line of the list.  */
+  void begin_line () { pp_clear_output_area (m_printer); }
+
+  /* Add the text of the current line to the list, with LOC and with no
+     trailing newline.  A text sink prints the location of a context line as
+     print_location does: the expansion of LOC, with its column only when
+     the context shows columns.  */
+  void end_line (location_t loc)
+  {
+    char *text = xstrdup (pp_formatted_text (m_printer));
+    size_t length = strlen (text);
+    while (length > 0 && text[length - 1] == '\n')
+      text[--length] = '\0';
+    expanded_location text_location = expand_location (loc);
+    if (!m_context.m_show_column)
+      text_location.column = -1;
+    m_lines->add (loc, text_location, text, m_kind, false);
+    free (text);
+    pp_clear_output_area (m_printer);
+  }
+
+private:
+  diagnostics::text_sink *m_text_output;
+  diagnostics::context &m_context;
+  pretty_printer *m_printer;
+  diagnostics::context_lines *m_lines;
+  bool m_update_state;
+  const char *m_kind;
+};
