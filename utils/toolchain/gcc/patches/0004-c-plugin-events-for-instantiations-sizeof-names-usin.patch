diff --git a/gcc/testsuite/g++.dg/plugin/name_use_plugin.cc b/gcc/testsuite/g++.dg/plugin/name_use_plugin.cc
new file mode 100644
index 00000000000..ab7da9a9eaf
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/name_use_plugin.cc
@@ -0,0 +1,66 @@
+/* A plugin that gives a warning for each use of a declaration whose name
+   starts with "tracked_" that PLUGIN_NAME_USE reports, at the place where
+   the source spells the name or expands the macro that spells it.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_name_use (tree decl, location_t location, void *)
+{
+  if (BASELINK_P (decl))
+    decl = BASELINK_FUNCTIONS (decl);
+  if (TREE_CODE (decl) == OVERLOAD)
+    decl = OVL_FIRST (decl);
+  if (!DECL_P (decl) || DECL_NAME (decl) == NULL_TREE
+      || strncmp (IDENTIFIER_POINTER (DECL_NAME (decl)), "tracked_", 8) != 0)
+    return;
+  const char *kind = "declaration";
+  switch (TREE_CODE (decl))
+    {
+    case NAMESPACE_DECL:
+      kind = "namespace";
+      break;
+    case TYPE_DECL:
+      kind = "type";
+      break;
+    case TEMPLATE_DECL:
+      kind = "template";
+      break;
+    case FUNCTION_DECL:
+      kind = "function";
+      break;
+    case VAR_DECL:
+      kind = "variable";
+      break;
+    case FIELD_DECL:
+      kind = "member";
+      break;
+    default:
+      break;
+    }
+  location_t loc = linemap_resolve_location (line_table, location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  warning_at (loc, 0, "use of %s %qs", kind,
+	      IDENTIFIER_POINTER (DECL_NAME (decl)));
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_NAME_USE,
+		     (plugin_callback_func) (void (*) (void)) plugin_name_use,
+		     NULL);
+  return 0;
+}
