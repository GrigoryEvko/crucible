diff --git a/gcc/cp/parser.cc b/gcc/cp/parser.cc
index bf981945aa0..e793ef4111d 100644
--- a/gcc/cp/parser.cc
+++ b/gcc/cp/parser.cc
@@ -10293,6 +10293,12 @@ cp_parser_unary_expression (cp_parser *parser, cp_id_kind * pidk,
 		ret = cxx_sizeof_or_alignof_expr (compound_loc, operand, op,
 						  std_alignof, true);
 	      }
+	    if (ret != error_mark_node)
+	      {
+		plugin_sizeof_or_alignof_data data = { operand, compound_loc,
+						       op };
+		invoke_plugin_callbacks (PLUGIN_SIZEOF_OR_ALIGNOF, &data);
+	      }
 	    /* For SIZEOF_EXPR, just issue diagnostics, but keep
 	       SIZEOF_EXPR with the original operand.  */
 	    if (op == SIZEOF_EXPR && ret != error_mark_node)
@@ -10481,7 +10487,17 @@ cp_parser_unary_expression (cp_parser *parser, cp_id_kind * pidk,
 	return cp_parser_delete_expression (parser);
     }
   else if (cp_lexer_next_token_is (parser->lexer, CPP_REFLECT_OP))
-    return cp_parser_reflect_expression (parser);
+    {
+      tree reflection = cp_parser_reflect_expression (parser);
+      if (REFLECT_EXPR_P (reflection))
+	{
+	  plugin_reflection_data data
+	    = { PLUGIN_REFLECT_OPERATOR, REFLECT_EXPR_HANDLE (reflection),
+		EXPR_LOCATION (reflection) };
+	  invoke_plugin_callbacks (PLUGIN_REFLECTION, &data);
+	}
+      return reflection;
+    }
 
   /* Look for a unary operator.  */
   unary_operator = cp_parser_unary_operator (token);
@@ -22119,6 +22135,10 @@ cp_parser_explicit_instantiation (cp_parser* parser)
   int declares_class_or_enum;
   cp_decl_specifier_seq decl_specifiers;
   tree extension_specifier = NULL_TREE;
+  /* The type or the declaration that the directive instantiates, for the
+     plugin event PLUGIN_EXPLICIT_INSTANTIATION.  */
+  tree instantiated = NULL_TREE;
+  location_t start_loc = cp_lexer_peek_token (parser->lexer)->location;
 
   auto_timevar tv (TV_TEMPLATE_INST);
 
@@ -22165,8 +22185,12 @@ cp_parser_explicit_instantiation (cp_parser* parser)
 	 template instantiation.  */
       pop_deferring_access_checks ();
       if (type)
-	do_type_instantiation (type, extension_specifier,
-			       /*complain=*/tf_error);
+	{
+	  do_type_instantiation (type, extension_specifier,
+				 /*complain=*/tf_error);
+	  if (type != error_mark_node)
+	    instantiated = type;
+	}
     }
   else
     {
@@ -22208,6 +22232,8 @@ cp_parser_explicit_instantiation (cp_parser* parser)
 	  pop_deferring_access_checks ();
 	  /* Do the explicit instantiation.  */
 	  do_decl_instantiation (decl, extension_specifier);
+	  if (decl && decl != error_mark_node)
+	    instantiated = decl;
 	}
       else
 	{
@@ -22216,6 +22242,13 @@ cp_parser_explicit_instantiation (cp_parser* parser)
 	  cp_parser_skip_to_end_of_statement (parser);
 	}
     }
+  if (instantiated)
+    {
+      plugin_explicit_instantiation_data data
+	= { instantiated, start_loc,
+	    extension_specifier == ridpointers[(int) RID_EXTERN] };
+      invoke_plugin_callbacks (PLUGIN_EXPLICIT_INSTANTIATION, &data);
+    }
   /* We're done with the instantiation.  */
   end_explicit_instantiation ();
 
@@ -24543,7 +24576,14 @@ cp_parser_namespace_alias_definition (cp_parser* parser)
   cp_parser_require (parser, CPP_SEMICOLON, RT_SEMICOLON);
 
   /* Register the alias in the symbol table.  */
-  do_namespace_alias (id_location, identifier, namespace_specifier);
+  if (tree alias = do_namespace_alias (id_location, identifier,
+				       namespace_specifier))
+    {
+      plugin_using_form_data data
+	= { PLUGIN_NAMESPACE_ALIAS, alias, DECL_NAMESPACE_ALIAS (alias),
+	    id_location };
+      invoke_plugin_callbacks (PLUGIN_USING_FORM, &data);
+    }
 }
 
 /* Parse a qualified-namespace-specifier.
@@ -24592,7 +24632,7 @@ finish_using_decl (tree qscope, tree identifier, bool typename_p = false)
       finish_member_declaration (decl);
     }
   else
-    finish_nonmember_using_decl (qscope, identifier);
+    decl = finish_nonmember_using_decl (qscope, identifier);
   return decl;
 }
 
@@ -24763,6 +24803,13 @@ cp_parser_using_declaration (cp_parser* parser,
 	  cp_parser_require (parser, CPP_SEMICOLON, RT_SEMICOLON);
 	  return false;
 	}
+      if (decl)
+	{
+	  plugin_using_form_data data
+	    = { PLUGIN_USING_DECLARATION, decl, USING_DECL_DECLS (decl),
+		token->location };
+	  invoke_plugin_callbacks (PLUGIN_USING_FORM, &data);
+	}
     }
 
   if (!access_declaration_p
@@ -24981,6 +25028,10 @@ cp_parser_alias_declaration (cp_parser* parser)
   if (pushed_scope)
     pop_scope (pushed_scope);
 
+  plugin_using_form_data data
+    = { PLUGIN_ALIAS_DECLARATION, decl, type, id_location };
+  invoke_plugin_callbacks (PLUGIN_USING_FORM, &data);
+
   /* If decl is a template, return its TEMPLATE_DECL so that it gets
      added into the symbol table; otherwise, return the TYPE_DECL.  */
   if (DECL_LANG_SPECIFIC (decl)
@@ -25021,6 +25072,7 @@ cp_parser_using_directive (cp_parser* parser)
   cp_parser_require_keyword (parser, RID_USING, RT_USING);
   /* And the `namespace' keyword.  */
   cp_parser_require_keyword (parser, RID_NAMESPACE, RT_NAMESPACE);
+  location_t name_location = cp_lexer_peek_token (parser->lexer)->location;
   if (cp_parser_nth_token_starts_splice_without_nns_p (parser, 1))
     namespace_decl = cp_parser_splice_specifier (parser);
   else
@@ -25043,6 +25095,12 @@ cp_parser_using_directive (cp_parser* parser)
 
   /* Update the symbol table.  */
   finish_using_directive (namespace_decl, attribs);
+  if (namespace_decl != error_mark_node)
+    {
+      plugin_using_form_data data
+	= { PLUGIN_USING_DIRECTIVE, NULL_TREE, namespace_decl, name_location };
+      invoke_plugin_callbacks (PLUGIN_USING_FORM, &data);
+    }
 
   /* Look for the final `;'.  */
   cp_parser_require (parser, CPP_SEMICOLON, RT_SEMICOLON);
@@ -35552,6 +35610,22 @@ cp_parser_lookup_name (cp_parser *parser, tree name,
 	      || TREE_CODE (decl) == UNBOUND_CLASS_TEMPLATE
 	      || BASELINK_P (decl));
 
+  /* The plugin event PLUGIN_NAME_USE.  A dependent name gives no event.
+     The test of the code of DECL comes right after the assertion above,
