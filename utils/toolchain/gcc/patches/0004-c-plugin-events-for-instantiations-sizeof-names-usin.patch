diff --git a/gcc/testsuite/g++.dg/plugin/reflection-plugin-test.C b/gcc/testsuite/g++.dg/plugin/reflection-plugin-test.C
new file mode 100644
index 00000000000..ebce28a8501
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/reflection-plugin-test.C
@@ -0,0 +1,31 @@
+// Test the plugin event PLUGIN_REFLECTION: one event for each
+// reflect-expression, and one for each splice-specifier that the front end
+// resolves, at parse time or at the instantiation of a template.
+// { dg-do compile }
+// { dg-options "-std=c++26 -freflection" }
+
+namespace tracked_ns
+{
+  int tracked_var = 1;
+  struct tracked_type { int tracked_field = 0; };
+  int tracked_fn ();
+}
+
+constexpr auto reflected_ns = ^^tracked_ns; // { dg-warning "reflection of namespace 'tracked_ns'" }
+constexpr auto reflected_type = ^^tracked_ns::tracked_type; // { dg-warning "reflection of type 'tracked_type'" }
+constexpr auto reflected_fn = ^^tracked_ns::tracked_fn; // { dg-warning "reflection of function 'tracked_fn'" }
+int spliced = [: ^^tracked_ns::tracked_var :]; // { dg-warning "reflection of variable 'tracked_var'" }
+// { dg-warning "splice of variable 'tracked_var'" "" { target *-*-* } .-1 }
+typename [: ^^tracked_ns::tracked_type :] object {}; // { dg-warning "reflection of type 'tracked_type'" }
+// { dg-warning "splice of type 'tracked_type'" "" { target *-*-* } .-1 }
+int member = object.[: ^^tracked_ns::tracked_type::tracked_field :]; // { dg-warning "reflection of data member 'tracked_field'" }
+// { dg-warning "splice of data member 'tracked_field'" "" { target *-*-* } .-1 }
+
+template <auto R>
+int
+pattern ()
+{
+  return [: R :]; // { dg-warning "splice of variable 'tracked_var'" }
+}
+
+int instantiated = pattern<^^tracked_ns::tracked_var> (); // { dg-warning "reflection of variable 'tracked_var'" }
diff --git a/gcc/testsuite/g++.dg/plugin/reflection_plugin.cc b/gcc/testsuite/g++.dg/plugin/reflection_plugin.cc
new file mode 100644
index 00000000000..a4f10f2a0e3
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/reflection_plugin.cc
@@ -0,0 +1,57 @@
+/* A plugin that gives a warning for each entity whose name starts with
+   "tracked_" that PLUGIN_REFLECTION reports, with the kind of the event.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_reflection (void *event_data, void *)
+{
+  plugin_reflection_data *data = (plugin_reflection_data *) event_data;
+  tree entity = data->entity;
+  if (BASELINK_P (entity))
+    entity = BASELINK_FUNCTIONS (entity);
+  if (TREE_CODE (entity) == OVERLOAD)
+    entity = OVL_FIRST (entity);
+  const char *kind = "declaration";
+  if (TYPE_P (entity))
+    {
+      kind = "type";
+      entity = TYPE_NAME (entity);
+    }
+  else if (TREE_CODE (entity) == NAMESPACE_DECL)
+    kind = "namespace";
+  else if (TREE_CODE (entity) == FUNCTION_DECL)
+    kind = "function";
+  else if (VAR_P (entity))
+    kind = "variable";
+  else if (TREE_CODE (entity) == FIELD_DECL)
+    kind = "data member";
+  if (entity == NULL_TREE || !DECL_P (entity) || DECL_NAME (entity) == NULL_TREE
+      || strncmp (IDENTIFIER_POINTER (DECL_NAME (entity)), "tracked_", 8) != 0)
+    return;
+  location_t loc = linemap_resolve_location (line_table, data->location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  warning_at (loc, 0, "%s of %s %qs",
+	      data->kind == PLUGIN_REFLECT_OPERATOR ? "reflection" : "splice",
+	      kind, IDENTIFIER_POINTER (DECL_NAME (entity)));
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_REFLECTION,
+		     plugin_reflection, NULL);
+  return 0;
+}
diff --git a/gcc/testsuite/g++.dg/plugin/sizeof-plugin-test.C b/gcc/testsuite/g++.dg/plugin/sizeof-plugin-test.C
new file mode 100644
index 00000000000..9c52aa8d5b4
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/sizeof-plugin-test.C
@@ -0,0 +1,48 @@
+// Test the plugin event PLUGIN_SIZEOF_OR_ALIGNOF: one event for each sizeof
+// and alignof that the parser reads, also in a template, in a macro and in
+// the arguments of a call, and no event for the instantiation of a template.
+// { dg-do compile }
+
+struct Box { int value; };
+using Alias = Box;
+
+unsigned long of_type = sizeof (Box); // { dg-warning "sizeof of type 'Box'" }
+unsigned long of_alias = sizeof (Alias); // { dg-warning "sizeof of type 'Alias'" }
+unsigned long of_align = alignof (double); // { dg-warning "alignof of type 'double'" }
+unsigned long of_gnu_align = __alignof__ (long); // { dg-warning "alignof of type 'long int'" }
+
+Box box;
+unsigned long of_expression = sizeof box; // { dg-warning "sizeof of an expression of type 'Box'" }
+
+void *
+storage ()
+{
+  return __builtin_malloc (sizeof (Box)); // { dg-warning "sizeof of type 'Box'" }
+}
+
+template <class T>
+unsigned long
+size_of ()
+{
+  return sizeof (T); // { dg-warning "sizeof of type 'T'" }
+}
+
+template <class T>
+unsigned long
+size_of_value (T value)
+{
+  return sizeof value // { dg-warning "sizeof of a type-dependent expression" }
+	 + sizeof (value + 1); // { dg-warning "sizeof of a type-dependent expression" }
+}
+
+template <class... Types>
+unsigned long
+count_of ()
+{
+  return sizeof... (Types); // { dg-warning "sizeof of type" }
+}
+
+unsigned long instantiated = size_of<char> () + size_of_value (1) + count_of<int, char> ();
+
+#define SIZE_OF(TYPE) sizeof (TYPE)
+unsigned long of_macro = SIZE_OF (short); // { dg-warning "sizeof of type 'short int'" }
diff --git a/gcc/testsuite/g++.dg/plugin/sizeof_plugin.cc b/gcc/testsuite/g++.dg/plugin/sizeof_plugin.cc
new file mode 100644
index 00000000000..bec8c5d6c39
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/sizeof_plugin.cc
@@ -0,0 +1,43 @@
+/* A plugin that gives a warning for each sizeof and alignof expression that
+   PLUGIN_SIZEOF_OR_ALIGNOF reports, at the place where the source spells the
+   expression or expands the macro that spells it.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_sizeof_or_alignof (void *event_data, void *)
+{
+  plugin_sizeof_or_alignof_data *data
+    = (plugin_sizeof_or_alignof_data *) event_data;
+  location_t loc = linemap_resolve_location (line_table, data->location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  const char *name = data->code == SIZEOF_EXPR ? "sizeof" : "alignof";
+  tree operand = data->operand;
+  if (TYPE_P (operand))
+    warning_at (loc, 0, "%s of type %qT", name, operand);
+  else if (type_dependent_expression_p (operand))
+    warning_at (loc, 0, "%s of a type-dependent expression", name);
+  else
+    warning_at (loc, 0, "%s of an expression of type %qT", name,
+		TREE_TYPE (operand));
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_SIZEOF_OR_ALIGNOF,
+		     plugin_sizeof_or_alignof, NULL);
+  return 0;
+}
diff --git a/gcc/testsuite/g++.dg/plugin/using-form-plugin-test.C b/gcc/testsuite/g++.dg/plugin/using-form-plugin-test.C
new file mode 100644
index 00000000000..692338e0957
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/using-form-plugin-test.C
@@ -0,0 +1,40 @@
+// Test the plugin event PLUGIN_USING_FORM: one event for each
+// using-declaration, using-directive, namespace alias and alias declaration,
+// at each scope, also in a macro, and one event for each name of a list.
+// { dg-do compile }
+// { dg-options "-std=c++20" }
+
+namespace tracked_ns
+{
+  int tracked_fn ();
+  int tracked_fn (int);
+  struct tracked_base { void member (); };
+}
+
+using tracked_ns::tracked_fn; // { dg-warning "using-declaration of 'tracked_fn': target overload at namespace scope" }
+using namespace tracked_ns; // { dg-warning "using-directive of namespace 'tracked_ns' at namespace scope" }
+namespace tracked_alias = tracked_ns; // { dg-warning "namespace alias 'tracked_alias' of 'tracked_ns' at namespace scope" }
+using tracked_type = tracked_ns::tracked_base; // { dg-warning "alias declaration 'tracked_type' of 'tracked_ns::tracked_base' at namespace scope" }
+template <class T>
+using tracked_pointer = T *; // { dg-warning "alias declaration 'tracked_pointer' of 'T.' at namespace scope" }
+
+struct derived : tracked_ns::tracked_base
+{
+  using tracked_ns::tracked_base::member; // { dg-warning "using-declaration of 'member': target function_decl in a class" }
+  using member_type = int; // { dg-warning "alias declaration 'member_type' of 'int' in a class" }
+};
+
+void
+block ()
+{
+  using tracked_ns::tracked_fn; // { dg-warning "using-declaration of 'tracked_fn': target overload in a block" }
+  using namespace tracked_ns; // { dg-warning "using-directive of namespace 'tracked_ns' in a block" }
+  namespace local_alias = tracked_ns; // { dg-warning "namespace alias 'local_alias' of 'tracked_ns' in a block" }
+  using local_type = int; // { dg-warning "alias declaration 'local_type' of 'int' in a block" }
+}
+
+#define USE_TRACKED using namespace tracked_ns;
+USE_TRACKED // { dg-warning "using-directive of namespace 'tracked_ns' at namespace scope" }
+
+using tracked_ns::tracked_fn, tracked_ns::tracked_base; // { dg-warning "using-declaration of 'tracked_fn': target overload at namespace scope" }
+// { dg-warning "using-declaration of 'tracked_base': target type_decl at namespace scope" "" { target *-*-* } .-1 }
diff --git a/gcc/testsuite/g++.dg/plugin/using_form_plugin.cc b/gcc/testsuite/g++.dg/plugin/using_form_plugin.cc
new file mode 100644
index 00000000000..4798271c45a
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/using_form_plugin.cc
@@ -0,0 +1,58 @@
+/* A plugin that gives a warning for each using form that PLUGIN_USING_FORM
+   reports, with its scope, at the place where the source spells the form or
+   expands the macro that spells it.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_using_form (void *event_data, void *)
+{
+  plugin_using_form_data *data = (plugin_using_form_data *) event_data;
+  location_t loc = linemap_resolve_location (line_table, data->location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  const char *scope = (at_namespace_scope_p () ? "at namespace scope"
+		       : at_class_scope_p () ? "in a class" : "in a block");
+  switch (data->kind)
+    {
+    case PLUGIN_USING_DECLARATION:
+      warning_at (loc, 0, "using-declaration of %qE: target %s %s",
+		  DECL_NAME (data->decl),
+		  (data->target != NULL_TREE
+		   ? get_tree_code_name (TREE_CODE (data->target))
+		   : "dependent name"),
+		  scope);
+      break;
+    case PLUGIN_USING_DIRECTIVE:
+      warning_at (loc, 0, "using-directive of namespace %qD %s",
+		  data->target, scope);
+      break;
+    case PLUGIN_NAMESPACE_ALIAS:
+      warning_at (loc, 0, "namespace alias %qD of %qD %s", data->decl,
+		  data->target, scope);
+      break;
+    case PLUGIN_ALIAS_DECLARATION:
+      warning_at (loc, 0, "alias declaration %qE of %qT %s",
+		  DECL_NAME (data->decl), data->target, scope);
+      break;
+    }
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_USING_FORM,
+		     plugin_using_form, NULL);
+  return 0;
+}
