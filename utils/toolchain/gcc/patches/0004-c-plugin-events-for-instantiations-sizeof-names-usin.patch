+/* Invoke the plugin event PLUGIN_NAME_USE for DECL, which a name at
+   LOCATION resolves to.  cp_parser_lookup_name calls this function only
+   when a plugin reads the event, and it keeps the event out of its own
+   code.  */
+
+static void ATTRIBUTE_COLD __attribute__ ((__noinline__))
+cp_parser_name_use_event (tree decl, location_t location)
+{
+  if (DECL_P (decl) || TREE_CODE (decl) == OVERLOAD || BASELINK_P (decl))
+    {
+      plugin_name_use_data data = { decl, location };
