+++ b/gcc/testsuite/g++.dg/plugin/explicit-instantiation-plugin-test.C
@@ -0,0 +1,30 @@
+// Test the plugin event PLUGIN_EXPLICIT_INSTANTIATION: one event for each
+// explicit instantiation directive, also in a macro, and no event for an
+// explicit specialization or an implicit instantiation.
+// { dg-do compile }
+
+template <class T> struct Box { T value; };
+template <class T> int count (T *) { return 0; }
+template <class T> struct Holder
+{
+  static T shared;
+  void touch () {}
+};
+template <class T> T Holder<T>::shared;
+
+template struct Box<int>; // { dg-warning "explicit instantiation definition of class 'Box<int>'" }
+extern template struct Box<long>; // { dg-warning "explicit instantiation declaration of class 'Box<long int>'" }
+
+template int count<int> (int *); // { dg-warning "explicit instantiation definition of function 'int count\\(T\\*\\) \\\[with T = int\\\]'" }
+template int count (char *); // { dg-warning "explicit instantiation definition of function 'int count\\(T\\*\\) \\\[with T = char\\\]'" }
+extern template int count<long> (long *); // { dg-warning "explicit instantiation declaration of function 'int count\\(T\\*\\) \\\[with T = long int\\\]'" }
+
+template int Holder<int>::shared; // { dg-warning "explicit instantiation definition of variable 'Holder<int>::shared'" }
+template void Holder<char>::touch (); // { dg-warning "explicit instantiation definition of function 'void Holder<T>::touch\\(\\) \\\[with T = char\\\]'" }
+
+#define INSTANTIATE_BOX(TYPE) template struct Box<TYPE>;
+INSTANTIATE_BOX (short) // { dg-warning "explicit instantiation definition of class 'Box<short int>'" }
+
+template <> struct Box<double> { };
+Box<float> implicit_box;
+int implicit_count = count<unsigned> (nullptr);
diff --git a/gcc/testsuite/g++.dg/plugin/explicit_instantiation_plugin.cc b/gcc/testsuite/g++.dg/plugin/explicit_instantiation_plugin.cc
new file mode 100644
index 00000000000..0b62c6addce
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/explicit_instantiation_plugin.cc
@@ -0,0 +1,44 @@
+/* A plugin that gives a warning for each explicit instantiation directive
+   that PLUGIN_EXPLICIT_INSTANTIATION reports, at the place where the source
+   spells the directive or expands the macro that spells it.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_explicit_instantiation (void *event_data, void *)
+{
+  plugin_explicit_instantiation_data *data
+    = (plugin_explicit_instantiation_data *) event_data;
+  location_t loc = linemap_resolve_location (line_table, data->location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  const char *form = (data->extern_p
+		      ? "explicit instantiation declaration"
+		      : "explicit instantiation definition");
+  tree entity = data->entity;
+  if (TYPE_P (entity))
+    warning_at (loc, 0, "%s of class %qT", form, entity);
+  else if (TREE_CODE (entity) == FUNCTION_DECL)
+    warning_at (loc, 0, "%s of function %qD", form, entity);
+  else
+    warning_at (loc, 0, "%s of variable %qD", form, entity);
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_EXPLICIT_INSTANTIATION,
+		     plugin_explicit_instantiation, NULL);
+  return 0;
+}
diff --git a/gcc/testsuite/g++.dg/plugin/member-access-plugin-test.C b/gcc/testsuite/g++.dg/plugin/member-access-plugin-test.C
new file mode 100644
index 00000000000..828998ae1a7
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/member-access-plugin-test.C
@@ -0,0 +1,40 @@
+// Test the plugin event PLUGIN_MEMBER_ACCESS: one event for each member
+// that a class member access with "." or "->" designates, also through a
+// splice, in a macro and at the instantiation of a template, and no event
+// for a member that a member function names with no object.
+// { dg-do compile }
+// { dg-options "-std=c++26 -freflection" }
+
+struct tracked_holder
+{
+  int tracked_field = 0;
+  static int tracked_static;
+  int tracked_method () const { return tracked_field; }
+  template <class T> T tracked_template () const { return T (); }
+};
+
+int tracked_holder::tracked_static = 1;
+
+int
+use (tracked_holder holder, tracked_holder *pointer)
+{
+  int sum = holder.tracked_field; // { dg-warning "access to data member 'tracked_field' of 'tracked_holder'" }
+  sum += pointer->tracked_field; // { dg-warning "access to data member 'tracked_field' of 'tracked_holder'" }
+  sum += holder.tracked_static; // { dg-warning "access to static data member 'tracked_static' of 'tracked_holder'" }
+  sum += holder.tracked_method (); // { dg-warning "access to member function 'tracked_method' of 'tracked_holder'" }
+  sum += pointer->template tracked_template<int> (); // { dg-warning "access to member template 'tracked_template' of 'tracked_holder'" }
+  sum += holder.[: ^^tracked_holder::tracked_field :]; // { dg-warning "access to data member 'tracked_field' of 'tracked_holder' through a splice" }
+  return sum;
+}
+
+#define TRACKED_FIELD(object) (object).tracked_field
+int expanded = TRACKED_FIELD (tracked_holder {}); // { dg-warning "access to data member 'tracked_field' of 'tracked_holder'" }
+
+template <class T>
+int
+pattern (T object)
+{
+  return object.tracked_field; // { dg-warning "access to data member 'tracked_field' of 'tracked_holder'" }
+}
+
+int instantiated = pattern (tracked_holder {});
diff --git a/gcc/testsuite/g++.dg/plugin/member_access_plugin.cc b/gcc/testsuite/g++.dg/plugin/member_access_plugin.cc
new file mode 100644
index 00000000000..37eca48a08a
--- /dev/null
+++ b/gcc/testsuite/g++.dg/plugin/member_access_plugin.cc
@@ -0,0 +1,57 @@
+/* A plugin that gives a warning for each member whose name starts with
+   "tracked_" that PLUGIN_MEMBER_ACCESS reports, at the place where the
+   source spells the access or expands the macro that spells it.  */
+
+#include "gcc-plugin.h"
+#include <stdlib.h>
+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "tree.h"
+#include "intl.h"
+#include "cp/cp-tree.h"
+#include "diagnostic.h"
+
+int plugin_is_GPL_compatible;
+
+static void
+plugin_member_access (void *event_data, void *)
+{
+  plugin_member_access_data *data = (plugin_member_access_data *) event_data;
+  tree member = data->member;
+  const char *kind = "member";
+  if (BASELINK_P (member))
+    {
+      kind = "member function";
+      member = BASELINK_FUNCTIONS (member);
+    }
+  if (TREE_CODE (member) == TEMPLATE_ID_EXPR)
+    {
+      kind = "member template";
+      member = TREE_OPERAND (member, 0);
+    }
+  if (TREE_CODE (member) == OVERLOAD)
+    member = OVL_FIRST (member);
+  if (TREE_CODE (member) == FIELD_DECL)
+    kind = "data member";
+  else if (VAR_P (member))
+    kind = "static data member";
+  if (!DECL_P (member) || DECL_NAME (member) == NULL_TREE
+      || strncmp (IDENTIFIER_POINTER (DECL_NAME (member)), "tracked_", 8) != 0)
+    return;
+  location_t loc = linemap_resolve_location (line_table, data->location,
+					      LRK_MACRO_EXPANSION_POINT,
+					      NULL);
+  warning_at (loc, 0, "access to %s %qs of %qT%s", kind,
+	      IDENTIFIER_POINTER (DECL_NAME (member)), data->object_type,
+	      data->splice_p ? " through a splice" : "");
+}
+
+int
+plugin_init (struct plugin_name_args *plugin_info,
+	     struct plugin_gcc_version *)
+{
+  register_callback (plugin_info->base_name, PLUGIN_MEMBER_ACCESS,
+		     plugin_member_access, NULL);
+  return 0;
+}
