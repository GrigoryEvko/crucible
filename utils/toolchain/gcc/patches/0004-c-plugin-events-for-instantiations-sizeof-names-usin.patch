diff --git a/gcc/cp/cp-tree.h b/gcc/cp/cp-tree.h
index 6f36a12e9cb..fc3cfc69e49 100644
--- a/gcc/cp/cp-tree.h
+++ b/gcc/cp/cp-tree.h
@@ -8153,6 +8153,99 @@ extern tree attr_chainon (tree, tree);
 extern tree maybe_add_dummy_lambda_op (tree);
 extern void remove_dummy_lambda_op (tree, tree);
 
+/* The data of the plugin event PLUGIN_EXPLICIT_INSTANTIATION.  The parser
+   invokes the event one time for each explicit instantiation directive that
+   it parses with no error, after it does the instantiation.  */
+
+struct plugin_explicit_instantiation_data
+{
+  /* The type that the directive instantiates, or the declaration of the
+     function or variable that it instantiates.  */
+  tree entity;
+  /* The location of the first token of the directive: the "template"
+     keyword, or the storage class or function specifier before it.  */
+  location_t location;
+  /* True for an explicit instantiation declaration: "extern template".  */
+  bool extern_p;
+};
+
+/* The data of the plugin event PLUGIN_SIZEOF_OR_ALIGNOF.  The parser invokes
+   the event for each sizeof or alignof expression that it parses with no
+   error, also in a template, before the operand is folded to a constant.
+   The parser can read one expression more than one time when it parses
+   tentatively, so a plugin can see one operator more than one time.  */
+
+struct plugin_sizeof_or_alignof_data
+{
+  /* The operand as the parser read it: a type, or an expression.  */
+  tree operand;
+  /* The location of the expression, from the keyword to the end of the
+     operand.  */
+  location_t location;
+  /* SIZEOF_EXPR or ALIGNOF_EXPR.  */
+  enum tree_code code;
+};
+
+/* The kinds of a form of the plugin event PLUGIN_USING_FORM.  */
+
+enum plugin_using_form_kind
+{
+  PLUGIN_USING_DECLARATION,
+  PLUGIN_USING_DIRECTIVE,
+  PLUGIN_NAMESPACE_ALIAS,
+  PLUGIN_ALIAS_DECLARATION
+};
+
+/* The data of the plugin event PLUGIN_USING_FORM.  The parser invokes the
+   event for each using-declaration, using-directive, namespace alias and
+   alias declaration that it parses with no error, at each scope.  A
+   using-declaration with a list of names gives one event for each name.  */
+
+struct plugin_using_form_data
+{
+  enum plugin_using_form_kind kind;
+  /* What the form declares: the USING_DECL of a using-declaration, the
+     NAMESPACE_DECL of a namespace alias, the TYPE_DECL of an alias
+     declaration, or NULL_TREE for a using-directive.  */
+  tree decl;
+  /* What the form names: the declarations that a using-declaration names,
+     the namespace that a using-directive nominates or that a namespace alias
+     names, or the type that an alias declaration names.  */
+  tree target;
+  /* The location of the name that the form names or declares.  */
+  location_t location;
+};
+
+/* The kinds of the plugin event PLUGIN_REFLECTION.  */
+
+enum plugin_reflection_kind
+{
+  /* A reflect-expression: ^^X.  */
+  PLUGIN_REFLECT_OPERATOR,
+  /* A splice-specifier: [:R:].  */
+  PLUGIN_SPLICE
+};
+
+/* The data of the plugin event PLUGIN_REFLECTION.  The parser invokes the
+   event for each reflect-expression that it parses with no error.  The
+   front end invokes it each time that it resolves a splice-specifier, at
+   parse time, or at the instantiation of a template when the splice is
+   dependent.  The parser can read one expression more than one time when it
+   parses tentatively, so a plugin can see one reflection more than one
+   time.  */
+
+struct plugin_reflection_data
+{
+  enum plugin_reflection_kind kind;
+  /* The entity that the reflection represents, or that the splice
+     designates: a declaration, a type, a namespace, or a TREE_BINFO of a
+     direct base.  */
+  tree entity;
+  /* The location of the operand of the reflect-expression, or
+     input_location when the front end resolves the splice.  */
+  location_t location;
+};
+
 /* in pt.cc */
 extern tree canonical_type_parameter		(tree);
 extern void push_access_scope			(tree);
diff --git a/gcc/cp/name-lookup.cc b/gcc/cp/name-lookup.cc
index 1db4a314571..bec8db29aa2 100644
--- a/gcc/cp/name-lookup.cc
+++ b/gcc/cp/name-lookup.cc
@@ -6898,13 +6898,14 @@ pop_decl_namespace (void)
   decl_namespace_list->pop ();
 }
 
-/* Process a namespace-alias declaration.  */
+/* Process a namespace-alias declaration.  Return the NAMESPACE_DECL of the
+   alias, or NULL_TREE after an error.  */
 
-void
+tree
 do_namespace_alias (location_t loc, tree alias, tree name_space)
 {
   if (name_space == error_mark_node)
-    return;
+    return NULL_TREE;
 
   if (TREE_CODE (name_space) == NAMESPACE_DECL)
     name_space = ORIGINAL_NAMESPACE (name_space);
@@ -6921,7 +6922,7 @@ do_namespace_alias (location_t loc, tree alias, tree name_space)
   alias = pushdecl (alias);
 
   if (!DECL_P (alias) || !DECL_NAMESPACE_ALIAS (alias))
-    return;
+    return NULL_TREE;
 
   set_originating_module (alias);
   check_module_decl_linkage (alias);
@@ -6929,6 +6930,7 @@ do_namespace_alias (location_t loc, tree alias, tree name_space)
   /* Emit debug info for namespace alias.  */
   if (!building_stmt_list_p ())
     (*debug_hooks->early_global_decl) (alias);
+  return alias;
 }
 
 /* Like pushdecl, only it places DECL in the current namespace,
@@ -6994,21 +6996,22 @@ push_using_decl_bindings (tree name, tree value)
   push_using_decl_bindings (nullptr, name, value);
 }
 
-/* Process a using declaration in non-class scope.  */
+/* Process a using declaration in non-class scope.  Return its USING_DECL,
+   or NULL_TREE after an error.  */
 
-void
+tree
 finish_nonmember_using_decl (tree scope, tree name)
 {
   gcc_checking_assert (current_binding_level->kind != sk_class);
 
   if (scope == error_mark_node || name == error_mark_node)
-    return;
+    return NULL_TREE;
 
   name_lookup lookup (name);
 
   tree using_decl = lookup_using_decl (scope, lookup);
   if (!using_decl)
-    return;
+    return NULL_TREE;
 
   /* Emit debug info.  */
   if (!processing_template_decl)
@@ -7114,6 +7117,7 @@ finish_nonmember_using_decl (tree scope, tree name)
 	lookup.value = using_decl;
       push_using_decl_bindings (&lookup, name, NULL_TREE);
     }
+  return using_decl;
 }
 
 /* Return the declarations that are members of the namespace NS.  */
diff --git a/gcc/cp/name-lookup.h b/gcc/cp/name-lookup.h
