--- /dev/null
+++ b/gcc/testsuite/g++.dg/reflect/annotation_definition5.C
@@ -0,0 +1,27 @@
+// { dg-do compile }
+// { dg-additional-options "-fannotations-on-definition-only" }
+// -fannotations-on-definition-only changes no declaration without an
+// annotation, at each -std level, so a build can give it to each unit.
+
+struct C1;
+struct C1 { int i; };
+union U1;
+union U1 { int i; };
+template <typename T>
+struct T1;
+template <typename T>
+struct T1 { T t; };
+template <>
+struct T1<int>;
+template <>
+struct T1<int> { int i; };
+template struct T1<long>;
+enum E1 { a };
+struct F
+{
+  friend struct P1;
+  struct N1;
+};
+struct F::N1 {};
+struct __attribute__ ((aligned (8))) G1;
+struct G1 { int i; };
