diff --git a/gcc/testsuite/g++.dg/reflect/annotation_definition3.C b/gcc/testsuite/g++.dg/reflect/annotation_definition3.C
new file mode 100644
index 000000000..447df4e02
--- /dev/null
+++ b/gcc/testsuite/g++.dg/reflect/annotation_definition3.C
@@ -0,0 +1,75 @@
+// { dg-do compile { target c++26 } }
+// { dg-additional-options "-freflection" }
+// Without -fannotations-on-definition-only, an annotation on a declaration of
+// a class or enumeration that is not its definition can count as an
+// annotation of the type, and an annotation on the definition of an
+// enumeration after an opaque declaration does not count.  The test pins
+// that behavior, which annotation_definition1.C and annotation_definition2.C
+// change with the option.
+
+#include <meta>
+
+struct A { int v; };
+
+consteval std::size_t
+count (std::meta::info r)
+{
+  return std::meta::annotations_of (r).size ();
+}
+
+struct [[=A{1}]] C1;
+struct [[=A{2}]] C1;
+struct C1 {};
+struct [[=A{3}]] C1;			// { dg-warning "type attributes ignored after type is already defined" }
+static_assert (count (^^C1) == 2);
+
+union [[=A{1}]] U1;
+union U1 { int i; };
+static_assert (count (^^U1) == 1);
+
+template <typename T>
+struct [[=A{1}]] T1;
+template <typename T>
+struct T1 {};
+template <typename T>
+struct [[=A{2}]] T1;
+static_assert (count (^^T1<int>) == 2);
+
+template <typename T>
+struct S1 {};
+template <>
+struct [[=A{1}]] S1<int>;		// { dg-warning "attributes ignored on template instantiation" }
+template <>
+struct S1<int> {};
+static_assert (count (^^S1<int>) == 0);
+template <typename T>
+struct S1<T *> {};
+template <typename T>
+struct [[=A{1}]] S1<T *>;
+static_assert (count (^^S1<int *>) == 1);
+template struct [[=A{1}]] S1<long>;
+static_assert (count (^^S1<long>) == 1);
+extern template struct [[=A{1}]] S1<short>;
+static_assert (count (^^S1<short>) == 1);
+
+enum class [[=A{1}]] E1 : int;
+enum class E1 : int { a };
+enum class [[=A{2}]] E1 : int;		// { dg-warning "type attributes ignored after type is already defined" }
+static_assert (count (^^E1) == 1);
+enum class E2 : int;
+enum class [[=A{1}]] E2 : int { b };	// { dg-warning "type attributes ignored after type is already defined" }
+static_assert (count (^^E2) == 0);
+
+struct F
+{
+  friend struct [[=A{1}]] P1;		// { dg-warning "attribute ignored" }
+  struct [[=A{1}]] N1;
+};
+struct P1 {};
+struct F::N1 {};
+static_assert (count (^^P1) == 0);
+static_assert (count (^^F::N1) == 1);
+
+struct [[=A{1}]] P3 *p3;		// { dg-warning "attributes ignored on elaborated-type-specifier that is not a forward declaration" }
+struct P3 {};
+static_assert (count (^^P3) == 0);
diff --git a/gcc/testsuite/g++.dg/reflect/annotation_definition4.C b/gcc/testsuite/g++.dg/reflect/annotation_definition4.C
new file mode 100644
index 000000000..1e391c44f
--- /dev/null
+++ b/gcc/testsuite/g++.dg/reflect/annotation_definition4.C
@@ -0,0 +1,20 @@
+// { dg-do compile { target c++26 } }
+// { dg-additional-options "-freflection -fannotations-on-definition-only -fpermissive" }
+// The diagnostic of -fannotations-on-definition-only is an error and not a
+// warning: a diagnostic pragma does not turn it off, and -fpermissive does
+// not make it a warning.  A note names the rule.
+
+#pragma GCC diagnostic ignored "-Wattributes"
+
+struct A { int v; };
+
+struct [[=A{1}]] C1;	// { dg-error "annotation on a declaration of 'C1' that is not its definition" }
+// { dg-message "'-fannotations-on-definition-only' accepts an annotation of a class or enumeration only on its definition" "" { target *-*-* } .-1 }
+struct C1 {};
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wpedantic"
+enum class [[=A{1}]] E1 : int;	// { dg-error "annotation on a declaration of 'E1' that is not its definition" }
+// { dg-message "'-fannotations-on-definition-only' accepts an annotation of a class or enumeration only on its definition" "" { target *-*-* } .-1 }
+#pragma GCC diagnostic pop
+enum class E1 : int { a };
diff --git a/gcc/testsuite/g++.dg/reflect/annotation_definition5.C b/gcc/testsuite/g++.dg/reflect/annotation_definition5.C
