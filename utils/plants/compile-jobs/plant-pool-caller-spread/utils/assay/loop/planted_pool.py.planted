"""A planted module: a pool with the count that a caller gives, and a caller that gives its arguments through **."""

from concurrent.futures import ThreadPoolExecutor


def run_part(units: list[str], jobs: int) -> list[str]:
    """Return the units after a compile of each one, with the count of workers of the caller."""
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        return list(pool.map(str, units))


def run_all(units: list[str], settings: dict[str, int]) -> list[str]:
    """Return the units after the compiles of the count of the settings."""
    return run_part(units, **settings)
