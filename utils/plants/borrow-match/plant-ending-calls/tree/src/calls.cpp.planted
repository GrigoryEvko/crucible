// Each call of an arm of a borrow match that ends an owner of the receiver is a
// finding: by a reference, through a callee of two levels, with no body in the
// unit, through an object that holds the receiver, by a member function of that
// object, through a capture of a closure that the call gets, and in the arm of a
// container.  The opt-out region turns one call into opted-out.
#include <foundation/Quarantine.h>
#include <foundation/core/Array.h>
#include <foundation/core/Choice.h>
#include <foundation/core/OneOf.h>

#include <utility>

namespace planted {

namespace fc = ::foundation::core;

using Items = fc::HeapArray<int>;
using fc::Option;

struct Holder {
    Option<Items> held = Option<Items>::some(Items{});

    void clear() noexcept { held = fc::none; }

    unsigned long member() noexcept;
};

void clear(Option<Items>& held) noexcept { held = fc::none; }

void clear_twice(Option<Items>& held) noexcept { clear(held); }

void clear_out_of_line(Option<Items>& held) noexcept;

void clear_holder(Holder& holder) noexcept { holder.clear(); }

template <class Body>
void run(Body body) noexcept {
    body();
}

void replace(Items& items) noexcept { items = Items{}; }

void replace(fc::OneOf<Items, int>& held) noexcept { held = fc::OneOf<Items, int>{1}; }

// ── The calls ──

unsigned long by_reference() noexcept {
    Option<Items> held = Option<Items>::some(Items{});
    return held.match(
        [&held](Items const& items) noexcept {
            clear(held);
            return items.size();
        },
        [] noexcept { return 0UL; });
}

unsigned long through_two_levels() noexcept {
    Option<Items> held = Option<Items>::some(Items{});
    return held.match(
        [&held](Items const& items) noexcept {
            clear_twice(held);
            return items.size();
        },
        [] noexcept { return 0UL; });
}

unsigned long with_no_body() noexcept {
    Option<Items> held = Option<Items>::some(Items{});
    return held.match(
        [&held](Items const& items) noexcept {
            clear_out_of_line(held);
            return items.size();
        },
        [] noexcept { return 0UL; });
}

unsigned long holder_of_the_receiver(Holder& holder) noexcept {
    return holder.held.match(
        [&holder](Items const& items) noexcept {
            clear_holder(holder);
            return items.size();
        },
        [] noexcept { return 0UL; });
}

unsigned long Holder::member() noexcept {
    return held.match(
        [this](Items const& items) noexcept {
            clear();
            return items.size();
        },
        [] noexcept { return 0UL; });
}

unsigned long through_a_closure() noexcept {
    Option<Items> held = Option<Items>::some(Items{});
    return held.match(
        [&held](Items const& items) noexcept {
            run([&held] noexcept { held = fc::none; });
            return items.size();
        },
        [] noexcept { return 0UL; });
}

unsigned long one_of() noexcept {
    fc::OneOf<Items, int> held{Items{}};
    return held.match(
        [&held](Items const& items) noexcept {
            replace(held);
            return items.size();
        },
        [](int const&) noexcept { return 0UL; });
}

int element_of_an_array() noexcept {
    Items items{};
    int read = 0;
    std::as_const(items).with_element(
        0,
        [&items, &read](int const& element) noexcept {
            replace(items);
            read = element;
        },
        [] noexcept {});
    return read;
}

unsigned long opted_out() noexcept {
    Option<Items> held = Option<Items>::some(Items{});
    return held.match(
        [&held](Items const& items) noexcept {
            CRUCIBLE_I_KNOW_WHAT_IM_DOING("PROBE: the test ends the sum in a callee of the arm")
            clear(held);
            CRUCIBLE_END_I_KNOW_WHAT_IM_DOING
            return items.size();
        },
        [] noexcept { return 0UL; });
}

unsigned long calls(Holder& holder) noexcept {
    return by_reference() + through_two_levels() + with_no_body() + holder_of_the_receiver(holder) + holder.member()
         + through_a_closure() + one_of() + static_cast<unsigned long>(element_of_an_array()) + opted_out();
}

}  // namespace planted
