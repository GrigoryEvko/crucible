// Each write of an arm of a borrow match to the sum that the match reads is a
// finding: an assignment, a move and a mutating call, through a capture by
// reference of a local, a capture of this, a reference parameter, a local
// reference of the arm, an object that holds the receiver, a generic arm, an
// arm with a declared return type in an instance of a template, and the
// borrow match of a Result and of a OneOf.  The opt-out region turns one write
// into opted-out.
#include <foundation/Quarantine.h>
#include <foundation/core/Choice.h>
#include <foundation/core/OneOf.h>

#include <utility>

namespace planted {

using ::foundation::core::none;
using ::foundation::core::Option;

int assigned_local() {
    Option<int> held = Option<int>::some(1);
    return held.match([&](int const& value) { held = none; return value; }, [] { return 0; });
}

int moved_local() {
    Option<int> held = Option<int>::some(2);
    return held.match([&held](int const& value) { return std::move(held).value_or(0) + value; }, [] { return 0; });
}

int frame_of_the_sum(Option<int>& held) {
    return held.match([&](int const& value) {
        int total = value;
        total += held.with_mut([](auto item) noexcept { return *item; }, [] noexcept { return 0; });
        return total;
    }, [] { return 0; });
}

int generic_arm(Option<int>& held) {
    return held.match([&](auto const& value) { held = none; return value; }, [] { return 0; });
}

int local_reference(Option<int>& held) {
    return held.match([&](int const& value) {
        Option<int>& alias = held;
        alias = none;
        return value;
    }, [] { return 0; });
}

struct Holder {
    Option<int> held = Option<int>::some(3);

    int member() {
        return held.match([this](int const& value) { held = none; return value; }, [] { return 0; });
    }

    int whole() {
        return held.match([this](int const& value) { *this = Holder{}; return value; }, [] { return 0; });
    }
};

enum class Fault : unsigned char { broken };

template <class E>
int result_instance(::foundation::core::Result<int, E>& result) {
    return result.match([&](int const& value) -> int { return std::move(result).value_or(0) + value; },
                        [](E const&) { return 0; });
}

int one_of() {
    ::foundation::core::OneOf<int, long> held{4};
    return held.match([&](int const& value) { held = ::foundation::core::OneOf<int, long>{5L}; return value; },
                      [](long const& value) { return static_cast<int>(value); });
}

int opted(Option<int>& held) {
    CRUCIBLE_I_KNOW_WHAT_IM_DOING("PROBE: the test writes the sum in an arm")
    int value = held.match([&](int const& payload) { held = none; return payload; }, [] { return 0; });
    CRUCIBLE_END_I_KNOW_WHAT_IM_DOING
    return value;
}

// An arm that the call gets by name, as a closure or as an object of a class,
// and an arm that takes its payload by value, are arms too.
int named_closure(Option<int>& held) {
    auto arm = [&](int const& value) { held = none; return value; };
    return held.match(arm, [] { return 0; });
}

struct Clearing {
    Option<int>& target;
    int operator()(int const& value) const { target = none; return value; }
};

int named_object(Option<int>& held) {
    Clearing const arm{held};
    return held.match(arm, [] { return 0; });
}

int by_value_arm(Option<int>& held) {
    return held.match([&](int value) { held = none; return value; }, [] { return 0; });
}

// A call whose result is a class with a destructor is a write too: a take in a
// cast to void, a replace that initializes a local with a destructor, and an
// assignment in an arm of a match whose result has a destructor.
struct Handle {
    int value = 0;
    explicit Handle(int given) noexcept : value(given) {}
    Handle(Handle&& other) noexcept : value(other.value) { other.value = 0; }
    Handle& operator=(Handle&&) = delete;
    ~Handle() { value = -1; }
};

int taken(Option<Handle>& held) {
    return held.match([&](Handle const& handle) { static_cast<void>(held.take()); return handle.value; },
                      [] { return 0; });
}

int replaced(Option<Handle>& held) {
    return held.match([&](Handle const& handle) {
        Option<Handle> const old = held.replace(Handle{80});
        return handle.value + static_cast<int>(old.is_some());
    }, [] { return 0; });
}

Option<Handle> class_result(Option<Handle>& held) {
    return held.match([&](Handle const& handle) { held = none; return Option<Handle>::some(Handle{handle.value}); },
                      [] { return Option<Handle>{}; });
}

int instances(Option<int>& source, Option<Handle>& owned) {
    ::foundation::core::Result<int, Fault> result{6};
    Holder holder;
    return result_instance(result) + holder.member() + holder.whole() + assigned_local() + moved_local()
         + frame_of_the_sum(source) + generic_arm(source) + local_reference(source) + one_of() + opted(source)
         + named_closure(source) + named_object(source) + by_value_arm(source) + taken(owned) + replaced(owned)
         + static_cast<int>(class_result(owned).is_some());
}

// The body of a loop over a sum is an arm too: an assignment of a local, a
// move through a reference parameter, and a mutating call through the
// capture of this, also with a loop variable by value.
int loop_assigns() {
    Option<int> held = Option<int>::some(7);
    int total = 0;
    for (int const& value : held) {
        held = none;
        total += value;
    }
    return total;
}

int loop_moves(Option<int>& held) {
    int total = 0;
    for (int const& value : held) {
        total += std::move(held).value_or(0) + value;
    }
    return total;
}

struct LoopHolder {
    Option<int> held = Option<int>::some(8);

    int member() {
        int total = 0;
        for (int value : held) {
            static_cast<void>(held.take());
            total += value;
        }
        return total;
    }
};

int loops(Option<int>& source) {
    LoopHolder holder;
    return loop_assigns() + loop_moves(source) + holder.member();
}

}  // namespace planted
