namespace crucible::planted {

template <bool (*Predicate)(int)>
struct Refined {};

using Positive = Refined<::foundation::decide::positive>;

int checked(int value) {
    CRUCIBLE_PRE(::foundation::decide::positive(value));
    contract_assert(value > 0);
    CRUCIBLE_POST(value, value > 0);
    return value;
}

}  // namespace crucible::planted
