// A quarantined unit that spells std::tuple_element of a family type, in a
// declaration and in the initializer of an init-capture.  The admit row of
// std::tuple_element holds only the base, so each name is a use of std.
#include <fixy/Pair.h>

namespace planted {

int spell(int seed) noexcept {
    std::tuple_element<0, ::fixy::Pair>::type value = seed;
    return value;
}

int spell_in_capture(int seed) noexcept {
    auto read = [held = std::tuple_element<1, ::fixy::Pair>::type{seed}]() noexcept { return held; };
    return read();
}

}  // namespace planted
