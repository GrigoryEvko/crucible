// Templates that hold the result of a base function with a placeholder and a
// dependent initializer.  The pattern keeps the placeholder, and each
// instantiation deduces std::vector, so the plant expects one finding on
// the line of each placeholder.  A type that a template parameter gives is no
// finding in the instantiation: the code spells it where it names the template.

#include <fixy/Deduced.h>

#include <vector>

template <class T>
unsigned long deduced_local(T const& value) {
    auto held = fixy::deduced_test::make_list(value);
    static_cast<void>(held);
    return 0;
}

template <class T>
auto deduced_return(T const& value) {
    return fixy::deduced_test::make_list(value);
}

template <class T>
void deduced_parameter(T value) {
    T copy = value;
    static_cast<void>(copy);
}

void deduced_use() {
    static_cast<void>(deduced_local(1));
    static_cast<void>(deduced_local(2.0));
    static_cast<void>(deduced_return(1));
    std::vector<int> items{};
    deduced_parameter(items);
}
