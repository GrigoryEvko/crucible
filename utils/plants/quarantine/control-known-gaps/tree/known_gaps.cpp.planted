// The uses that the plugin does not see at this time.  Each line that the
// manifest of control-known-gaps names holds a library entity, and the plugin
// gives no finding of that entity there.  A change that closes a gap makes the
// control fail, and that change moves the line and its finding to a plant, so
// the list of the gaps only becomes shorter.

#include <array>

static_assert(size(std::array<int, 3>{}) == 3);
