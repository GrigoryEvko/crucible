#pragma once

// A base header with the two marks of foundation/ByteSeal.h.  The argument of
// a function with the mark free_door, and the conversion of a parameter in
// the body of a function with the mark erasure_door, are no view of bytes.
#include <foundation/ByteSeal.h>
#include <foundation/core/OneOf.h>

namespace fixy::doors {

using Reading = ::foundation::core::OneOf<unsigned int, unsigned short>;

[[= ::foundation::core::free_door{}]] void release_storage(void* storage) noexcept;

inline void release_reading(Reading* reading) noexcept {
    reading->~Reading();
    release_storage(static_cast<void*>(reading));
}

class Erased {
    void* address_ = nullptr;

public:
    template <class T>
    [[= ::foundation::core::erasure_door{}]] static Erased of(T& object) noexcept {
        Erased erased;
        erased.address_ = static_cast<void*>(__builtin_addressof(object));
        return erased;
    }
};

inline Erased erase_reading(Reading& reading) noexcept { return Erased::of(reading); }

}  // namespace fixy::doors
