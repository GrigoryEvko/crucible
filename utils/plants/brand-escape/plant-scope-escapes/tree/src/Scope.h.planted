#pragma once

// A scope mint with the shape of mint_branded_scope: it calls the body with
// a view of the scope brand of the call, and an index of that view needs no
// check.  One call site gives each of its calls one brand.

#include <foundation/Brand.h>

namespace planted {

template <class Brand>
struct Index {
    unsigned value = 0;
};

template <class Brand>
struct View {
    unsigned count = 0;
    [[nodiscard]] Index<Brand> last() const noexcept { return Index<Brand>{count - 1}; }
};

template <class... Refused, class Body, class Fresh = CRUCIBLE_SCOPE_BRAND>
    requires(sizeof...(Refused) == 0)
[[nodiscard]] auto scope(unsigned count, Body body) noexcept {
    return body(View<Fresh>{count});
}

}  // namespace planted
