build bin/tool: CXX_EXECUTABLE_LINKER__tool_Debug tool.o
build tool.o: CXX_COMPILER__tool_unscanned_Debug tool.cpp
build gen.h: CUSTOM_COMMAND gen.in || bin/tool
build cmake_object_order_depends_target_user: phony || gen.h
build user.o: CXX_COMPILER__user_unscanned_Debug user.cpp || cmake_object_order_depends_target_user
build all: phony bin/tool user.o
default all
