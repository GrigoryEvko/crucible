// A plant of use-after-move: the parentheses around std::move do not change the move, and the code after it reads t.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
void take(Token&&);
void read(Token const&);

void must_catch_parenthesized_move(Token t) { take((std::move)(t)); read(t); }
