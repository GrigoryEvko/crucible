// A plant of use-after-move: this->a is the member a that the move spent.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
void take(Token&&);
void read(Token const&);

struct This {
    Token a; Token b;
    void must_catch_this_arrow() { take(std::move(a)); read(this->a); }
};
