// A known miss of use-after-move.  The lambda reads token by reference, and it runs after the move of token.  Its
// read is then a use after move.  The rule walks the lambda body at the point of the lambda, before the move, and it
// reads the body with a live token.  When the rule learns to refuse this shape, this control fails, and it becomes a
// plant.
#include <utility>
struct Token { int value; };
void sink(Token&&);
void read(Token const&);

void evade_late_reference_capture(Token token) {
    auto later = [&token] { read(token); };
    sink(std::move(token));
    later();
}
