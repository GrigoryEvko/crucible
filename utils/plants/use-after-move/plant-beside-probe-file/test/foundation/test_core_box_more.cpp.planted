// A plant of use-after-move: a test beside a file of PROBE_FILES, with a path that the list does not hold, reads a
// moved-from object.  The rule reads the file.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
void take(Token&&);
void read(Token const&);

void must_catch_use(Token t) { take(std::move(t)); read(t); }
