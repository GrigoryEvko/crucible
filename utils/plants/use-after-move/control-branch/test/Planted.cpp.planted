// A control of use-after-move: the move and the read are in two different branches of the if.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
void take(Token&&);
void read(Token const&);
bool pick();

void must_accept_branch(Token t) { if (pick()) { take(std::move(t)); } else { read(t); } }
