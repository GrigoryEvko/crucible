// A plant of use-after-move: the range for reads each element of ts, also the element ts[0] that the move spent.
#include <array>
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
using Arr = std::array<Token, 2>;
void take(Token&&);
void read(Token const&);

void must_catch_range_for(Arr& ts) { take(std::move(ts[0])); for (Token const& t : ts) read(t); }
