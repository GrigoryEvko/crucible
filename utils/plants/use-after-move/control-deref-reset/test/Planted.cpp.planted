// A control of use-after-move: `reset` makes o live again, and the read of *o is in the branch where o holds a value.
#include <optional>
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
using Opt = std::optional<Token>;
void take(Token&&);
void read(Token const&);

void must_accept_deref_reset(Opt o) { take(std::move(*o)); o.reset(); if (o) { read(*o); } }
