// A plant of use-after-move: the let-else with no early value moves t in its operand, and the code after it moves t
// again.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
Option<Token> lend(Token&&);
void take(Token&&);

void must_catch_let_else_empty_value(Token t) {
    CRUCIBLE_LET_ELSE(end, lend(std::move(t)), );
    take(std::move(end));
    take(std::move(t));
}
