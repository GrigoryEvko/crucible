// A plant of use-after-move: std::move(*o) spends the object that o holds, and o->size() calls a member of it.
#include <optional>
#include <utility>
struct Token { Token() = default; Token(Token&&) {} int size() const; };
using Opt = std::optional<Token>;
void take(Token&&);

int must_catch_pointee_then_arrow_call(Opt o) { take(std::move(*o)); return o->size(); }
