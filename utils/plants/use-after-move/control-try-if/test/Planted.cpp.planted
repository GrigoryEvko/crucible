// A control of use-after-move: the branch runs only when try_take did not succeed, and such a try_ call keeps t.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
bool try_take(Token&&);
void read(Token const&);

void must_accept_try_if(Token t) { if (!try_take(std::move(t))) { read(t); } }
