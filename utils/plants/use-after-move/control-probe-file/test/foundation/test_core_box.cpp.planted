// A control of use-after-move: a test of PROBE_FILES reads a moved-from object on purpose, and the rule does not read
// the file.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
void take(Token&&);
void read(Token const&);

void probe_reads_a_moved_token(Token t) { take(std::move(t)); read(t); }
