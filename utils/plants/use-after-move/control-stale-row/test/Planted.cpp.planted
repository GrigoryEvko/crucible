// A control of use-after-move: the ledger has a row for a function that has no finding.  The row admits nothing, and
// the rule passes, because a ledger fails only on a growth.
#include <utility>
struct Token { Token() = default; Token(Token&&) {} };
void take(Token&&);
void read(Token const&);

void must_catch_use(Token t) { take(std::move(t)); read(t); }
