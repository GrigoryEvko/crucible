// A plant of use-after-move: std::move(o) spends o, and (*o).size reads a member of the object that o held.
#include <optional>
#include <utility>
struct Token { Token() = default; Token(Token&&) {} int size = 0; };
using Opt = std::optional<Token>;
void take(Opt&&);

int must_catch_whole_then_deref_member(Opt o) { take(std::move(o)); return (*o).size; }
