// The two routes that the summaries of a closure and of a callee close (THE
// SUMMARIES of linear.cpp).  Each function can end a full Option of a linear
// payload.
#include <foundation/Linear.h>
#include <foundation/core/Choice.h>

#include <utility>

namespace planted {

using ::foundation::core::Option;

struct [[= ::foundation::linear::linear{}]] Token {
    int handle = 0;
    constexpr explicit Token(int value) noexcept : handle{value} {}
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&& other) noexcept {
        handle = other.handle;
        return *this;
    }
    Token(const Token&) = delete;
};

void sink(Token&& token) noexcept;
void keep(Option<Token>& held) noexcept;
void fill_kept() noexcept;
[[noreturn]] void stop() noexcept;

// A callee that gives the reference back.  Its body names only a reference to
// the Option, so the Option is not complete there, and the callee keeps the
// reference all the same.
Option<Token>& same_option(Option<Token>& held) noexcept { return held; }

// A capture by reference fills the Option after the consume.  The summary of
// the closure says that its body fills the sum, so the call of the closure
// gives the sum a payload again.
void alias_fills_after_the_consume() {
    Option<Token> held = Option<Token>::some(Token{1});
    auto refill = [&held] { held.fill(Token{2}); };
    sink(std::move(held).expect("the Option holds the first token"));
    refill();
}

// The callee keeps the reference, and a later call fills the Option through
// it.  The unit has no body of the callee, so no summary says that it keeps no
// reference, and the test after the call shows nothing.
void callee_keeps_the_reference() {
    Option<Token> held{};
    keep(held);
    do {
        if (!(held.is_none())) stop();
    } while (0);
    fill_kept();
}

// A closure that fills the sum, passed to a callee after the consume.  The
// callee can call the closure, so the sum can hold a payload again.
template <class Body>
void run_body(Body& body) noexcept {
    body();
}

void filling_closure_passed_after_the_consume() {
    Option<Token> held = Option<Token>::some(Token{3});
    auto refill = [&held] { held.fill(Token{4}); };
    sink(std::move(held).expect("the Option holds the first token"));
    run_body(refill);
}

// A callee keeps the reference, and a call after the consume fills the Option
// through it.
void kept_reference_fills_after_the_consume() {
    Option<Token> held = Option<Token>::some(Token{5});
    keep(held);
    sink(std::move(held).expect("the Option holds the first token"));
    fill_kept();
}

// A reference member of a local names the Option, and a fill through it after
// the consume gives the Option a payload again.
struct Keeper {
    Option<Token>& held;
};

void member_reference_fills_after_the_consume() {
    Option<Token> held = Option<Token>::some(Token{6});
    Keeper keeper{held};
    sink(std::move(held).expect("the Option holds the first token"));
    keeper.held.fill(Token{7});
}

// The reference that a callee gives back fills the Option after the consume.
void returned_reference_fills_after_the_consume() {
    Option<Token> held = Option<Token>::some(Token{8});
    Option<Token>& alias = same_option(held);
    sink(std::move(held).expect("the Option holds the first token"));
    alias.fill(Token{9});
}

// A callee that gives back the result of a callee that gives the sum back.
Option<Token>& outer_option(Option<Token>& held) noexcept { return same_option(held); }

void outer_reference_fills_after_the_consume() {
    Option<Token> held = Option<Token>::some(Token{10});
    Option<Token>& alias = outer_option(held);
    sink(std::move(held).expect("the Option holds the first token"));
    alias.fill(Token{11});
}

// The result goes to a callee that keeps it, and a later call fills the
// Option after a test.
void kept_result_fills_after_a_test() {
    Option<Token> held{};
    keep(same_option(held));
    do {
        if (!(held.is_none())) stop();
    } while (0);
    fill_kept();
}

// The result goes into a reference member, which fills the Option after the
// consume.
void member_of_the_result_fills_after_the_consume() {
    Option<Token> held = Option<Token>::some(Token{12});
    Keeper keeper{same_option(held)};
    sink(std::move(held).expect("the Option holds the first token"));
    keeper.held.fill(Token{13});
}

}  // namespace planted
