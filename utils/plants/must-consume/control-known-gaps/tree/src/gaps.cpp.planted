// The known gaps of the rule.  The front end folds the initializer of a
// temporary that a reference extends, and it gives no event
// PLUGIN_FOLDED_INITIALIZER for that fold.  So the move of the parameter into
// the call is not in the tree, and the parameter is unconsumed.
#include <foundation/Linear.h>

namespace planted {

struct [[= ::foundation::linear::linear{}]] Token {
    constexpr Token() noexcept = default;
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&&) noexcept { return *this; }
    Token(const Token&) = delete;
};

struct Pair {
    Token left;
    Token right;
};

[[= ::foundation::linear::drop_door{}]] constexpr Pair split(Token&&) noexcept { return Pair{}; }
void take(Pair&& pair) noexcept;

void extended_temporary(Token&& parent) {
    auto&& pair = split(static_cast<Token&&>(parent));
    take(static_cast<Pair&&>(pair));
}

// A self-move through a reference that a dereference or an index initializes,
// with no write of the pointer or the index between: the reference and the
// target name one object, and the kind self-move gives no line.  The rule
// takes such a reference as no alias, because a later write of the pointer or
// the index can change the object of the same expression.  A flow-sensitive
// form can close the gap.  The guards of a session handle stay as its run-time
// backstop.
void self_move_through_a_dereference(Token& held) noexcept {
    Token* const place = &held;
    Token& same = *place;
    *place = static_cast<Token&&>(same);
}

void self_move_through_an_index(Token (&row)[2], int index) noexcept {
    Token& same = row[index];
    row[index] = static_cast<Token&&>(same);
}

}  // namespace planted
