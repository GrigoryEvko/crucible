// The ends of a linear sum that the rule does not see.  Each function can end
// a full Option of a linear payload, and the rule gives no line for it.  The
// end of a full Option of a linear payload ends the process at run time, so
// the owning storage of include/foundation/core/Choice.h catches each one.
#include <foundation/Linear.h>
#include <foundation/core/Choice.h>

#include <utility>

namespace planted {

using ::foundation::core::Option;

struct [[= ::foundation::linear::linear{}]] Token {
    int handle = 0;
    constexpr explicit Token(int value) noexcept : handle{value} {}
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&& other) noexcept {
        handle = other.handle;
        return *this;
    }
    Token(const Token&) = delete;
};

// A class that states its own end and holds an Option of a token as a data
// member.
struct [[= ::foundation::linear::linear{}]] Holder {
    Option<Token> held;
};

// A data member of a class: the drop door ends the class, and the body of a
// door gives no line.
void member_ends_in_a_door() { ::foundation::linear::drop(Holder{Option<Token>::some(Token{3})}); }

}  // namespace planted
