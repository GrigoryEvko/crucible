// The forms that the rule of the closures that a call owns admits (THE
// CLOSURES THAT A CALL OWNS of linear.cpp).
#include <foundation/Linear.h>

#include <utility>

namespace planted {

struct [[= ::foundation::linear::linear{}]] Token {
    int handle = 0;
    constexpr explicit Token(int value) noexcept : handle{value} {}
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&& other) noexcept {
        handle = other.handle;
        return *this;
    }
    Token(const Token&) = delete;
};

// A class that is linear by its two token fields.
struct Pair {
    Token first;
    Token second;
};

void sink(Token&& token) noexcept;
[[nodiscard]] int look(Token const& token) noexcept;
[[nodiscard]] bool should_give() noexcept;

// The once door owns a closure that consumes its token on each path.
void consumed_on_each_path() {
    auto give = [token = Token{1}]() mutable noexcept {
        if (should_give()) {
            sink(std::move(token));
        } else {
            sink(std::move(token));
        }
    };
    ::foundation::linear::call_once(std::move(give));
}

// The once door owns a closure that gives its token out as its value.
void token_given_out() {
    auto give = [token = Token{2}]() mutable noexcept { return std::move(token); };
    sink(::foundation::linear::call_once(std::move(give)));
}

// The once door owns a closure that consumes each field of a captured pair.
void each_field_consumed() {
    auto give = [pair = Pair{Token{3}, Token{4}}]() mutable noexcept {
        sink(std::move(pair.first));
        sink(std::move(pair.second));
    };
    ::foundation::linear::call_once(std::move(give));
}

// A capture by reference stays with the caller, which consumes it.
void reference_capture_stays() {
    Token held{5};
    auto read = [&held]() noexcept { return look(held); };
    (void)::foundation::linear::call_once(std::move(read));
    sink(std::move(held));
}

// A closure that the caller keeps and calls by name owns nothing that a call
// ends: the caller gives it to the once door at the end.
void kept_closure_then_the_once_door() {
    auto give = [token = Token{6}]() mutable noexcept {
        (void)look(token);
        sink(std::move(token));
    };
    ::foundation::linear::call_once(std::move(give));
}

}  // namespace planted
