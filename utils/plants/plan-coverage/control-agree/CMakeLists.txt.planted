cmake_minimum_required(VERSION 3.28)
project(planted NONE)
enable_testing()
add_test(NAME guard_plan_coverage COMMAND python3 ${CMAKE_SOURCE_DIR}/utils/bin/guard check --rule plan-coverage
         --build-dir ${CMAKE_BINARY_DIR})
add_test(NAME guard_header_alone COMMAND python3 ${CMAKE_SOURCE_DIR}/utils/bin/guard check --rule header-alone
         --build-dir ${CMAKE_BINARY_DIR})
add_test(NAME test_unit COMMAND ${CMAKE_COMMAND} -E true)
