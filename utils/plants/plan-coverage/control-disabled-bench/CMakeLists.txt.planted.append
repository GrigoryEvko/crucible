set(CMAKE_C_COMPILER_FORCED TRUE)
enable_language(C)
set(CMAKE_TEST_LAUNCHER python3 -S ${CMAKE_SOURCE_DIR}/utils/bin/loop test-step)
file(WRITE ${CMAKE_BINARY_DIR}/bench_leaf.c "int main(void) { return 0; }\n")
add_executable(bench_leaf ${CMAKE_BINARY_DIR}/bench_leaf.c)
set_target_properties(bench_leaf PROPERTIES FOLDER crucible_bench)
add_test(NAME bench_leaf COMMAND bench_leaf)
set_tests_properties(bench_leaf PROPERTIES DISABLED ON)
