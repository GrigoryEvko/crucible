#pragma once

// Macros that make a shape where a unit expands them.  No unit expands the
// last two macros, and their bodies give no finding (decision 5 of the
// quarantine plan).
#define FORGE_UNION(NAME) \
    union NAME {          \
        unsigned char byte; \
        int value;        \
    }
#define FORGE_CAST(RAW) static_cast<::forge::Door*>(RAW)
#define FORGE_JOIN(LEFT, RIGHT) LEFT##RIGHT
#define FORGE_INSTANTIATE(TYPE) template struct ::forge::Box<TYPE>;
#define FORGE_RAW(TYPE) ::operator new(sizeof(TYPE))
#define FORGE_SIZE(TYPE) sizeof(TYPE)
#define FORGE_NEVER_EXPANDED(NAME) \
    union NAME {                   \
        int value;                 \
    }
#define FORGE_NEVER_INSTANTIATED template struct ::forge::Box<double>;
