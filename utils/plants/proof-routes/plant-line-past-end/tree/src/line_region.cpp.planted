#include <foundation/Quarantine.h>

// A #line directive maps the region after it onto line 2 of this file, an
// empty line.  The two macros of the region are then past the end of the
// line that the file cache of the plugin reads.  The plugin of main ended
// there with std::out_of_range from basic_string::compare.
namespace probe {

CRUCIBLE_I_KNOW_WHAT_IM_DOING("PROBE: a region before the directive")
inline int* before = nullptr;
CRUCIBLE_END_I_KNOW_WHAT_IM_DOING

#line 2
    CRUCIBLE_I_KNOW_WHAT_IM_DOING("PROBE: a region after the directive")
    inline int* after = nullptr;
    CRUCIBLE_END_I_KNOW_WHAT_IM_DOING

}  // namespace probe
