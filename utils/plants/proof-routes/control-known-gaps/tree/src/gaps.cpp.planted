#include <cstdlib>

#include <forge/Door.h>

// Three allocations with the size of forge::Door that the rule cannot see.
// The sizeof of a template parameter names the proof type only in an
// instantiation, and GCC gives no parser event for an instantiation.  A
// function with a name that is not the name of an allocation function can
// allocate.  A size that a variable holds is not a sizeof in the arguments of
// the call.
namespace forge {

template <class T> void* storage_of() { return std::malloc(sizeof(T)); }

void* through_template() { return storage_of<Door>(); }

void* through_wrapper() { return allocate(sizeof(Door)); }

void* through_variable() {
    const unsigned long size = sizeof(Door);
    return std::malloc(size);
}

}  // namespace forge
