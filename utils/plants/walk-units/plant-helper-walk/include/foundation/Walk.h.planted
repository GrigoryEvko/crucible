#pragma once
#include <meta>
namespace foundation::tags { struct First {}; }
namespace foundation {
consteval std::size_t count_in(std::meta::info ns) { return std::meta::members_of(ns, std::meta::access_context::unchecked()).size(); }
template <class = void>
consteval bool every_tag_is_empty() { return count_in(^^::foundation::tags) > 0; }
}  // namespace foundation
