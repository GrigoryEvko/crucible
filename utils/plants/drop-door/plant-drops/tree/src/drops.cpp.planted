// The drops of fixy/LinearDrops.h for three linear types.  The entity of a line
// names the type that ends, so the instance of each type gives its own line at
// each place of the header.  The ends of a Token and of a Ticket are clobbers
// of a trivial destructor.  The destructor of Sealed is user-provided, so the
// end of its member is a call of that destructor.
#include <foundation/ByteSeal.h>
#include <foundation/Linear.h>
#include <fixy/LinearDrops.h>

namespace planted {

struct [[= ::foundation::linear::linear{}, = ::foundation::lifetime::no_start_over_bytes{}]] Token {
    constexpr Token() noexcept = default;
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&&) noexcept { return *this; }
    Token(const Token&) = delete;
};

struct [[= ::foundation::linear::linear{}, = ::foundation::lifetime::no_start_over_bytes{}]] Ticket {
    constexpr Ticket() noexcept = default;
    constexpr Ticket(Ticket&&) noexcept = default;
    constexpr Ticket& operator=(Ticket&&) noexcept { return *this; }
    Ticket(const Ticket&) = delete;
};

struct [[= ::foundation::linear::linear{}, = ::foundation::lifetime::no_start_over_bytes{}]] Sealed {
    constexpr Sealed() noexcept = default;
    constexpr Sealed(Sealed&&) noexcept = default;
    constexpr Sealed& operator=(Sealed&&) noexcept { return *this; }
    Sealed(const Sealed&) = delete;
    ~Sealed() {}
};

void uses(Holder<Token>& holder, Token& slot, Token& last) { drops<Token>(holder, slot, &last); }

void uses_ticket(Holder<Ticket>& holder, Ticket& slot, Ticket& last) { drops<Ticket>(holder, slot, &last); }

void uses_sealed(Holder<Sealed>& holder) { end_member<Sealed>(holder); }

}  // namespace planted
