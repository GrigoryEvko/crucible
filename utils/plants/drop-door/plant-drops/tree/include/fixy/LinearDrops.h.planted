// Base templates that end a linear value that no tracked local holds: an
// assignment to a field, an assignment through a reference, an explicit
// destructor call through a pointer and on a member, and a delete-expression.
#pragma once

namespace planted {

template <class T>
struct Holder {
    T token;
};

template <class T>
void assign_member(Holder<T>& holder) {
    holder.token = T{};
}

template <class T>
void assign_through_reference(T& slot) {
    slot = T{};
}

template <class T>
void end_in_place(T* pointer) {
    pointer->~T();
}

template <class T>
void free_one(T* pointer) {
    delete pointer;
}

template <class T>
void end_member(Holder<T>& holder) {
    holder.token.~T();
}

// A union of the base that holds one alternative and ends it in place, as the
// alternatives of a sum do.  Its line names the place and no type.
template <class T>
union Alternative {
    T value;

    Alternative() noexcept {}
    ~Alternative() {}

    void end_value() noexcept { value.~T(); }
};

template <class T>
void drops(Holder<T>& holder, T& slot, T* pointer) {
    assign_member(holder);
    assign_through_reference(slot);
    end_in_place(pointer);
    free_one(pointer);
}

// An assignment to a pointer drops no object.  The assignment to the object
// behind the pointer drops the old value.
template <class T>
struct Slots {
    T* tail = nullptr;
    T* segments[2] = {};
};

template <class T>
void assign_pointers(Slots<T>& slots, T* first) {
    slots.tail = first;
    slots.segments[1] = first;
    slots.tail = nullptr;
    slots.tail = slots.tail + 1;
    *slots.tail = T{};
}

}  // namespace planted
