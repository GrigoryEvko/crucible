#include <foundation/Traits.h>

struct Widget {};

template <class T>
struct Holder {};

enum class Color { red, blue };

template <>
struct foundation::plant::describe<Widget> {
    static constexpr int value = 3;
};

template <class T>
struct foundation::plant::describe<Holder<T>> {
    static constexpr int value = 4;
};

template <>
struct foundation::plant::describe<Color> {
    static constexpr int value = 5;
};

template <>
inline constexpr bool foundation::plant::flagged<Widget> = true;

static_assert(foundation::plant::describe<Widget>::value == 3);
static_assert(foundation::plant::describe<Holder<int>>::value == 4);
