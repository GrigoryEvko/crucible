#include <foundation/Traits.h>

struct Fake {};

template <>
inline constexpr bool foundation::plant::is_admitted_v<Fake> = true;

namespace foundation::plant {
template <class T>
inline constexpr bool is_admitted_v<T*> = true;
}  // namespace foundation::plant

static_assert(foundation::plant::Admitted<Fake>);
static_assert(foundation::plant::Admitted<int*>);
