cmake_minimum_required(VERSION 3.25)
project(planted_export CXX)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
add_compile_options(-std=c++26 -fcontracts)
include_directories(include)
enable_testing()
add_executable(test_witnessed test/test_witnessed.cpp)
add_test(NAME test_witnessed COMMAND test_witnessed)
