struct Bg {};
struct OddRow {};
struct Lattice {};
struct Payload {};
struct Wide {};
struct Narrow {};
struct Wider {};

template <> class foundation::effects::ExecCtx<Bg, OddRow> { public: ExecCtx() = default; };
template <> class foundation::algebra::Graded<0, Lattice, Payload> { public: Payload anything; };
