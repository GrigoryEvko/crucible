#pragma once

namespace plant {

struct Thing {};

// Two classes carry the member name mint_member.  A fixture counts only for
// the class that it names.
struct Holder {
    [[nodiscard]] constexpr Thing mint_member() const noexcept { return {}; }
};
struct Keeper {
    [[nodiscard]] constexpr Thing mint_member() const noexcept { return {}; }
};

}  // namespace plant
