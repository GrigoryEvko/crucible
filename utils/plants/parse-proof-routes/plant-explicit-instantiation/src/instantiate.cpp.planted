// An explicit instantiation of a class and of a function, and an extern one.
// Each one does no access check of the names in it.
namespace forge {

template <class T> struct Box {
    T value{};
};

template <class T> int count(T*) { return 0; }

template struct Box<int>;

extern template struct Box<long>;

template int count<int>(int*);

}  // namespace forge
