// A planted door: the pin of the calling thread.
#pragma once

#include <sched.h>

namespace fixy::detail {

inline int pin_door(int cpu) noexcept {
    cpu_set_t mask;
    CPU_ZERO(&mask);
    CPU_SET(cpu, &mask);
    return ::sched_setaffinity(0, sizeof(mask), &mask);
}

}  // namespace fixy::detail
