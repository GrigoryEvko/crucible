// A planted grant file whose grant set is the set of its system calls.  A
// member call, a function of another namespace, a declaration and a comment
// that name a system call issue nothing: // ::prctl( and ::munlock(
#pragma once

#include <fixy/atoms/Syscall.h>
#include <fixy/os/Sched.h>

#include <sys/mman.h>
#include <sys/syscall.h>
#include <unistd.h>

namespace other {

inline int close(int value) noexcept {
    return value;
}

}  // namespace other

namespace crucible::warden {

struct Handle {
    int close() const noexcept { return 0; }
};

inline long mlock2_sys(unsigned long length) noexcept {
    return ::syscall(SYS_mlock2, 0, length, 0);
}

inline void apply(int cpu) noexcept {
    (void)::fixy::sched::open_door(cpu);
    (void)::madvise(nullptr, 0, MADV_NORMAL);
    (void)mlock2_sys(0);
    Handle file{};
    (void)file.close();
    (void)other::close(0);
    [[maybe_unused]] int close = 0;
}

namespace sc = ::fixy::atom::syscall;

using hardening_syscall_atoms =
    sc::grant_list<sc::per<sc::SyscallId::sched_setaffinity>, sc::per<sc::SyscallId::sched_getaffinity>,
                   sc::per<sc::SyscallId::madvise>, sc::per<sc::SyscallId::mlock2>>;

}  // namespace crucible::warden
