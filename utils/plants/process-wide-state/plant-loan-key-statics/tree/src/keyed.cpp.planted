// Objects with static or thread storage duration that reach a loan key or a
// keyed owner through a path that is not const.  A body with no capture
// reaches each of them, and the gate of a keyed frame door reads only the
// captures of a body, so such an object would let a body open a second frame
// of an owner.
#include <foundation/core/Array.h>
#include <foundation/core/Choice.h>
#include <foundation/core/Ref.h>

namespace planted {

namespace core = ::foundation::core;

// The brand of the member of a holder, and the holder.
struct HolderBrand final {};

struct Holder {
    core::FixedArray<int, 64, HolderBrand> array{};
};

// A keyed array and its key in a global.
auto g_pair = core::mint_keyed_owner(core::fixed_array_owner<int, 4>);

// A holder in a global, in a thread_local object, and behind a function.
Holder g_holder{};
thread_local Holder t_holder{};

Holder& reach_holder() noexcept {
    static Holder held{};
    return held;
}

// A global that refers to a holder.
core::Option<core::Ref<Holder>> g_holder_ref{};

// A const Ref of a holder in a member.  The const of a Ref is shallow, so the
// Ref still writes the holder.
struct ConstRefHolder {
    core::Ref<Holder> const holder;
};

void keep(Holder& held) noexcept {
    static ConstRefHolder by_const_ref{core::erase_brand(core::to(held))};
    static_cast<void>(by_const_ref);
}

}  // namespace planted
