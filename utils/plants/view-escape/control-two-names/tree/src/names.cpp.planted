// No call gives one object of a linear class or of a unique borrow class to two
// parameters that can write or move it, and no line names the rule view-escape.
// Two loans of one object, from a door or from a moved object, are no second
// name.  A capture of a different object is no second name, and an assignment
// takes a loan that a move of its own target gives.  A door of a part names its
// part, so two parts of a Record, a std::pair or a std::array are two objects.
#include <foundation/ByteSeal.h>
#include <foundation/Linear.h>
#include <foundation/core/Array.h>
#include <foundation/core/Index.h>
#include <foundation/core/Record.h>
#include <foundation/core/Region.h>

#include <array>
#include <tuple>
#include <utility>

namespace planted {

namespace fc = ::foundation::core;

struct [[= ::foundation::linear::linear{}]] Token {
    [[no_unique_address]] ::foundation::lifetime::byte_seal seal{};
    constexpr Token() noexcept = default;
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&&) noexcept = default;
    Token(const Token&) = delete;
};

struct Pair {
    Token first{};
    Token second{};
};

struct Plain {
    int value = 0;
};

class Holder {
public:
    Token& first() noexcept { return pair_.first; }
    Token& second() noexcept { return pair_.second; }

private:
    Pair pair_{};
};

void write_two(Token& one, Token& other) noexcept;
void read_two(Token const& one, Token const& other) noexcept;
void write_plain(Plain& one, Plain& other) noexcept;
void take_two(Token one, Token other) noexcept;

void two_objects(Token& token, Token& other) noexcept { write_two(token, other); }

void two_reads(Token& token) noexcept { read_two(token, token); }

void two_members(Pair& pair) noexcept { write_two(pair.first, pair.second); }

void plain_data(Plain& plain) noexcept { write_plain(plain, plain); }

void parts_from_a_door(Holder& holder) noexcept { write_two(holder.first(), holder.second()); }

void parts_of_a_moved_object(Pair pair) noexcept { take_two(std::move(pair.first), std::move(pair.second)); }

void parts_of_a_tuple(std::tuple<Token, Token>& tuple) noexcept { write_two(std::get<0>(tuple), std::get<1>(tuple)); }

template <class Body>
void write_beside(Token& token, Body& body) noexcept {
    Token taken{std::move(token)};
    token = std::move(taken);
    body();
}

void capture_of_a_different_object(Token& token, Token& other) noexcept {
    auto read = [&other]() noexcept { static_cast<void>(other); };
    write_beside(token, read);
}

void reborrow_into_its_name(fc::HeapArray<int>& items) noexcept {
    items = fc::with_mut(std::move(items), [](auto view) noexcept {
        view = fc::reborrow(std::move(view), [](auto lent) noexcept { static_cast<void>(lent); });
    });
}

void parts_of_a_record(fc::Record<Token, Token>& parts) noexcept {
    write_two(parts.at(fc::index<0>()), parts.at(fc::index<1>()));
}

void parts_of_a_pair(std::pair<Token, Token>& pair) noexcept { write_two(std::get<0>(pair), std::get<1>(pair)); }

void parts_of_an_array(std::array<Token, 2>& array) noexcept { write_two(std::get<0>(array), std::get<1>(array)); }

}  // namespace planted
