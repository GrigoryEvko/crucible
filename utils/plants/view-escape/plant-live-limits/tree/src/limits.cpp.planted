// Findings of the kind stale-borrow with no read of dead storage: the limits of
// the place analysis.  A join takes each end of its branches.  A door of a class
// gives a loan of its whole object.  Each element of an array is one place.  A swap
// in a callee reads as the end of its two owners.  A call that gives the old owner
// back to a local ends the borrow of its source, and so does a call that takes an
// owner out of the block of a Box.  A call that consumes a sum ends the borrows that
// its arm reads.  Two owners of one class in one object are one owner.
#include <foundation/core/Array.h>
#include <foundation/core/Choice.h>
#include <foundation/core/List.h>
#include <foundation/core/Ref.h>
#include <foundation/core/Region.h>

#include <utility>

namespace planted {

namespace fc = ::foundation::core;

using Items = fc::HeapArray<int>;
using View = fc::View<int const>;
using List = fc::FixedList<Items, 4>;
using Pair = fc::FixedArray<Items, 2>;

class Two {
public:
    View first() const& noexcept { return first_.view(); }
    void replace_second() noexcept { second_ = Items{}; }
    Items take_second() && noexcept { return std::move(second_); }

private:
    Items first_{};
    Items second_{};
};

void swap_owners(Items& first, Items& second) noexcept {
    Items held = std::move(first);
    first = std::move(second);
    second = std::move(held);
}

unsigned long paths_that_exclude_each_other(bool is_replaced) noexcept {
    Items items{};
    auto const view = items.view();
    if (is_replaced) {
        items = Items{};
    }
    return is_replaced ? 0 : view.size();
}

unsigned long different_element() noexcept {
    Pair pair{};
    auto const view = pair.at(fc::index<0>()).view();
    pair.set(fc::index<1>(), Items{});
    return view.size();
}

unsigned long different_member(Two& two) noexcept {
    auto const view = two.first();
    two.replace_second();
    return view.size();
}

unsigned long swap_in_a_callee() noexcept {
    Items first{};
    Items second{};
    auto const view = first.view();
    swap_owners(first, second);
    return view.size();
}

unsigned long old_owner_in_a_local(List list) noexcept {
    auto const view = list.get(0).expect("the list holds an element")->view();
    Items const held = list.exchange(fc::index<0>(), Items{});
    return view.size() + held.size();
}

unsigned long removed_owner_in_a_local(List list) noexcept {
    auto const view = list.get(0).expect("the list holds an element")->view();
    auto const held = list.remove(fc::index<0>());
    return view.size() + (held.is_some() ? 1 : 0);
}

unsigned long owner_out_of_a_box(fc::Box<Items> box) noexcept {
    auto const view = box->view();
    Items const items = std::move(box).consume();
    return view.size() + items.size();
}

unsigned long use_in_an_arm() noexcept {
    Items items{};
    auto const view = items.view();
    fc::Option<Items> option = fc::Option<Items>::some(std::move(items));
    return std::move(option).match([&view](Items taken) noexcept { return view.size() + taken.size(); },
                                   []() noexcept { return 0UL; });
}

unsigned long owner_of_the_same_class(Two two) noexcept {
    auto const view = two.first();
    { Items const items = std::move(two).take_second(); }
    return view.size();
}

// The record of a callee holds no order, so a callee that reads a borrow and
// then gives the owner beside it to a call that ends the owner ends the borrow.
void drop(Items items) noexcept {
    items = Items{};
}

unsigned long read_and_end(Items&& items, View view) noexcept {
    unsigned long const size = view.size();
    drop(std::move(items));
    return size;
}

unsigned long read_before_the_end() noexcept {
    Items items{};
    View const view = items.view();
    return read_and_end(std::move(items), view);
}

// A constructor names each of its arguments, so a capture of a class that holds
// no borrow and that a constructor builds from the View counts as a capture of
// the View, while the callee moves the owner on.
template <class Body>
Items run_with(Items items, Body body) noexcept {
    body();
    return items;
}

struct Count {
    unsigned long value = 0;
    explicit Count(View view) noexcept : value(view.size()) {}
};

unsigned long move_on_and_capture_a_count(Items& items, View view) noexcept {
    unsigned long size = 0;
    items = run_with(std::move(items), [count = Count{view}, &size]() noexcept { size = count.value; });
    return size;
}

unsigned long count_beside_an_owner_that_moves_on() noexcept {
    Items items{};
    View const view = items.view();
    return move_on_and_capture_a_count(items, view);
}

// A lend records the lent types and no place, so the lend of one member meets a
// View of a different member of the same type.
struct TwoItems {
    Items items{};
    Items others{};
};

template <class Body>
unsigned long lend_the_other_member(TwoItems& two, View view, Body&& body) noexcept {
    unsigned long size = 0;
    body(two.others, [&view, &size]() noexcept { size = view.size(); });
    return size;
}

unsigned long view_beside_a_lend_of_a_different_member() noexcept {
    TwoItems two{};
    View const view = two.items.view();
    return lend_the_other_member(two, view, [](Items& lent, auto&& read) noexcept {
        read();
        static_cast<void>(lent.size());
    });
}

}  // namespace planted
