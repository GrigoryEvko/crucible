// A Box holds an owner whose elements have no end of their own.  A door of that
// owner lends its run in place to a closure, and the closure ends the Box by a
// captured reference.  The run lies in the heap block of the Box, so each write of
// the closure after that end goes to freed storage.
#include <fixy/Core.h>
#include <foundation/core/WindowStack.h>
#include <foundation/effects/Effect.h>

#include <utility>

namespace planted {

namespace fc = ::foundation::core;

using Alloc = ::foundation::effects::Alloc;

template <class Owner>
void move_away_and_end(Owner& owner) noexcept {
    Owner const taken{std::move(owner)};
    static_cast<void>(taken);
}

template <class Owner>
[[nodiscard]] auto box_of(Alloc alloc, Owner&& owner) noexcept {
    return ::fixy::mint_box<Owner>(alloc, std::move(owner));
}

int end_the_box_of_a_keyed_array(Alloc alloc) noexcept {
    int read = 0;
    auto [array, key] = ::fixy::mint_keyed_owner(::fixy::fixed_array_owner<int, 8>);
    auto box = box_of(alloc, std::move(array));
    auto& held = *box;
    held.with_mut(key, [&box, &read](auto run) noexcept {
        move_away_and_end(box);
        for (int& element : run) {
            element = 7;
        }
        read = 7;
    });
    return read;
}

int end_the_box_of_a_window_stack(Alloc alloc) noexcept {
    int read = 0;
    auto box = fc::mint_box<fc::WindowStack<int, 8>>(alloc);
    auto& held = *box;
    held.with_window(
        fc::WindowCount{3},
        [&box, &read](auto window) noexcept {
            move_away_and_end(box);
            for (int& element : window) {
                element = 7;
            }
            read = 7;
        },
        []() noexcept {});
    return read;
}

}  // namespace planted
