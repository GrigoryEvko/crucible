// An owner of the base that keeps its blocks and that a caller can move.  A callee
// with no body can take the value of the owner away, so a call of that callee ends a
// borrow of a block.  The first three owners keep an object of each type in their
// blocks, and each of them holds a count of the type int too.  So the type of the
// result does not tell that the result names a block.  The blocks are the bytes behind
// a pointer, an array of bytes in a class behind a pointer, and the storage at an
// address that is a number.  The last owner keeps elements of one type, and a walk of
// it names the part that holds its pointers.
#include <foundation/AlignedBytes.h>
#include <foundation/core/Array.h>
#include <foundation/core/Owner.h>

namespace foundation::core {

class[[= owns_its_storage{}]] ByteBlocks final {
public:
    int const& at(unsigned long position) const& noexcept;

private:
    AlignedBytes bytes_{};
    int count_ = 0;
};

struct Node final {
    FixedArray<unsigned char, 64> bytes{};
};

class[[= owns_its_storage{}]] NodeBlocks final {
public:
    int const& at(unsigned long position) const& noexcept;

private:
    HeapArray<Node> nodes_{};
    int count_ = 0;
};

class[[= owns_its_storage{}]] NumberBlocks final {
public:
    NumberBlocks() noexcept = default;
    NumberBlocks(NumberBlocks&& other) noexcept;
    NumberBlocks& operator=(NumberBlocks&& other) noexcept;
    ~NumberBlocks();
    int const& at(unsigned long position) const& noexcept;

private:
    unsigned long origin_ = 0;
    int count_ = 0;
};

template <class Event>
struct ListState final {
    HeapArray<Event> events{};
};

template <class Event>
class[[= owns_its_storage{}]] EventList final {
public:
    Event const& at(unsigned long position) const& noexcept;

private:
    ListState<Event> state_{};
};

struct PaddedEvent final {
    unsigned long value = 0;
    FixedArray<unsigned char, 8> padding{};
};

}  // namespace foundation::core

namespace planted {

namespace fc = ::foundation::core;

struct Store final {
    fc::EventList<fc::PaddedEvent> log{};
};

struct Walk final {
    fc::ListState<fc::PaddedEvent> const& state;
};

Walk walk_of(Store const& store) noexcept;
unsigned long read(Walk walk) noexcept;
void change(fc::ByteBlocks& blocks) noexcept;
void change(fc::NodeBlocks& blocks) noexcept;
void change(fc::NumberBlocks& blocks) noexcept;
void change(Store& store) noexcept;

int byte_blocks(fc::ByteBlocks& blocks) noexcept {
    int const& value = blocks.at(0);
    change(blocks);
    return value;
}

int node_blocks(fc::NodeBlocks& blocks) noexcept {
    int const& value = blocks.at(0);
    change(blocks);
    return value;
}

int number_blocks(fc::NumberBlocks& blocks) noexcept {
    int const& value = blocks.at(0);
    change(blocks);
    return value;
}

unsigned long element_of_a_list(Store& store) noexcept {
    fc::PaddedEvent const& event = store.log.at(0);
    change(store);
    return event.value;
}

unsigned long walk_of_a_list(Store& store) noexcept {
    auto const walk = walk_of(store);
    change(store);
    return read(walk);
}

}  // namespace planted
