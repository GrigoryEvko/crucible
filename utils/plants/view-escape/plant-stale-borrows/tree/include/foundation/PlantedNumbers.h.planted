// A borrow class of the base that holds a number and states refers{}, but no
// refers_by_number{}.  It names no object, so no end can reach its loans, and
// the rule view-escape refuses the class in a header of the base.
#pragma once

#include <foundation/Transfer.h>

namespace foundation::core {

template <class Resource>
class[[= ::foundation::transfer::refers{}]] BareNumberRef final {
public:
    explicit BareNumberRef(int number) noexcept : number_{number} {}
    [[nodiscard]] bool is_open() const noexcept { return number_ >= 0; }

private:
    int number_ = -1;
};

}  // namespace foundation::core
