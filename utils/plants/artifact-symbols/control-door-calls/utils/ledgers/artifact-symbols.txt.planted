# A planted ledger: the door calls of foundation with the mark libc-allow.
format 1
rule artifact-symbols
@build/libfoundation.a | libc-allow | 1 | __errno_location | -
@build/libfoundation.a | libc-allow | 1 | abort | -
@build/libfoundation.a | libc-allow | 1 | read | -
@build/libfoundation.a | libc-allow | 1 | write | -
