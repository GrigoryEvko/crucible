include CMakeFiles/rules.ninja

build a.o: CXX_COMPILER__lib_unscanned_Debug a.cpp
  pool = compile
build b.o: CXX_COMPILER__lib_unscanned_Debug b.cpp
  pool = compile
build probe.bpf.o: CUSTOM_COMMAND probe.bpf.c
  depfile = CMakeFiles/d/probe.d
  deps = gcc
  pool = compile
build gen.h: CUSTOM_COMMAND gen.in
build liblib.a: CXX_STATIC_LIBRARY_LINKER__lib_Debug a.o b.o
  pool = link
build libshared.so: CXX_SHARED_LIBRARY_LINKER__shared_Debug a.o
  FLAGS = -g
  LINK_FLAGS = -fuse-ld=mold -Bplanted-mold/ -Wl,--threads=4 -Wl,--no-fork -Wl,-z,relro -Wl,-z,now
  pool = link
build tool: CXX_EXECUTABLE_LINKER__tool_Debug b.o || liblib.a
  FLAGS = -g -O1
  LINK_FLAGS = -fuse-ld=mold -Bplanted-mold/ -Wl,--threads=4 -Wl,--no-fork -Wl,-z,relro -Wl,-z,now -fPIE -pie
  pool = link
build all: phony liblib.a libshared.so tool probe.bpf.o gen.h
default all
