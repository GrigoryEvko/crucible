include CMakeFiles/rules.ninja

build a.o: CXX_COMPILER__lib_unscanned_Debug a.cpp
  pool = compile
build liblib.a: CXX_STATIC_LIBRARY_LINKER__lib_Debug a.o
build tool: CXX_EXECUTABLE_LINKER__tool_Debug a.o || liblib.a
  FLAGS = -g -O1
  LINK_FLAGS = -fuse-ld=mold -Bplanted-mold/ -Wl,--threads=4 -Wl,--no-fork -fPIE -pie
  pool = link
build all: phony liblib.a tool
default all
