// No line names the kind missing-mark: a marked parameter with its deleted
// twin, a parameter with a live rvalue overload, a deleted twin with no
// marker, a parameter whose type holds a borrow, a copy into the result, a
// parameter that a temporary cannot bind, a closure, a hidden friend with a
// friend twin, a deduced T&, and a result by an rvalue reference.
#include <foundation/Platform.h>
#include <foundation/core/List.h>
#include <foundation/core/Region.h>

namespace planted {

namespace fc = ::foundation::core;

using List = fc::FixedList<int, 4>;

fc::View<int const> marked_view_of(List const& list CRUCIBLE_LIFETIMEBOUND) { return list.view(); }
fc::View<int const> marked_view_of(List const&&) = delete("a View of a temporary list ends with the full expression");

int const& floor_of(List const& list, int const& floor) {
    static_cast<void>(list.size());
    return floor;
}
int floor_of(List const&, int const&&) noexcept { return 0; }

fc::View<int const> twinned_view_of(List const& list) { return list.view(); }
fc::View<int const> twinned_view_of(List&&) = delete("the twin alone guards the parameter");

fc::View<int const> same_view(fc::View<int const> const& run) { return run; }

List copy_of(List const& list) { return list; }

fc::View<int> writable_view_of(List& list) { return list.view(); }

struct Holder {
    friend fc::View<int const> view_of_holder(Holder const& holder) { return holder.list.view(); }
    friend void view_of_holder(Holder const&&) = delete("the friend twin refuses a temporary holder");
    List list{};
};

template <class Whole>
fc::View<int const> deduced_view_of(Whole& whole) {
    return whole.view();
}

List const&& forwarded(List const& list) { return static_cast<List const&&>(list); }

int read_all() {
    List list{};
    List const& seen = list;
    auto const view_of = [](List const& held) noexcept { return held.view(); };
    Holder const holder{};
    return static_cast<int>(marked_view_of(seen).size() + twinned_view_of(seen).size() + same_view(seen.view()).size()
                            + copy_of(seen).size() + writable_view_of(list).size() + view_of(seen).size()
                            + view_of_holder(holder).size() + deduced_view_of(seen).size()
                            + forwarded(seen).size())
         + floor_of(seen, seen.size() != 0 ? 1 : 0) + floor_of(seen, 2);
}

}  // namespace planted
