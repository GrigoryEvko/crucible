// The captures that the rule linear-capture admits: a move of a linear object
// into the closure, a capture by reference of a value that is not linear, and
// the capture of this.
#include <foundation/ByteSeal.h>
#include <foundation/Linear.h>

namespace planted {

struct [[= ::foundation::linear::linear{}, = ::foundation::lifetime::no_start_over_bytes{}]] Token {
    constexpr Token() noexcept = default;
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&&) noexcept { return *this; }
    Token(const Token&) = delete;
};

void take(Token&& token) noexcept;

struct Counter {
    int count = 0;
    void add() {
        auto bump = [this] { ++count; };
        bump();
    }
};

void captures() {
    Token token;
    int count = 0;
    auto moved = [held = static_cast<Token&&>(token)]() mutable { take(static_cast<Token&&>(held)); };
    auto counted = [&count] { ++count; };
    moved();
    counted();
}

}  // namespace planted
