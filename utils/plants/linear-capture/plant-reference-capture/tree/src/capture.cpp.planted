// A capture by reference of a linear object, by name and by the default
// capture.  No rule sees a consume through such a capture.
#include <foundation/ByteSeal.h>
#include <foundation/Linear.h>

namespace planted {

struct [[= ::foundation::linear::linear{}, = ::foundation::lifetime::no_start_over_bytes{}]] Token {
    constexpr Token() noexcept = default;
    constexpr Token(Token&&) noexcept = default;
    constexpr Token& operator=(Token&&) noexcept { return *this; }
    Token(const Token&) = delete;
};

void take(Token&& token) noexcept;

void captures() {
    Token named;
    Token defaulted;
    auto by_name = [&named] { take(static_cast<Token&&>(named)); };
    auto by_default = [&] { take(static_cast<Token&&>(defaulted)); };
    by_name();
    by_default();
}

// A class with a door at the end of its scope that is no loan key stays a
// finding.
struct [[= ::foundation::linear::linear{}, = ::foundation::linear::scope_end_door{},
         = ::foundation::lifetime::no_start_over_bytes{}]] ScopedToken {
    constexpr ScopedToken() noexcept = default;
    constexpr ScopedToken(ScopedToken&&) noexcept = default;
    constexpr ScopedToken& operator=(ScopedToken&&) noexcept { return *this; }
    ScopedToken(const ScopedToken&) = delete;
};

void lend(ScopedToken& token) noexcept;

void lends_scoped() {
    ScopedToken scoped;
    auto lent = [&scoped] { lend(scoped); };
    lent();
}

// A capture by const reference of a class with a door that consumes a const
// object stays a finding: a const&& member, and a mutable field.
struct [[= ::foundation::linear::linear{}, = ::foundation::lifetime::no_start_over_bytes{}]] ConstConsumed {
    constexpr ConstConsumed() noexcept = default;
    constexpr ConstConsumed(ConstConsumed&&) noexcept = default;
    constexpr ConstConsumed& operator=(ConstConsumed&&) noexcept { return *this; }
    ConstConsumed(const ConstConsumed&) = delete;
    [[nodiscard]] constexpr int consume() const&& noexcept { return 1; }
};

struct [[= ::foundation::linear::linear{}, = ::foundation::lifetime::no_start_over_bytes{}]] MutableHeld {
    mutable int spent = 0;
    constexpr MutableHeld() noexcept = default;
    constexpr MutableHeld(MutableHeld&&) noexcept = default;
    constexpr MutableHeld& operator=(MutableHeld&&) noexcept { return *this; }
    MutableHeld(const MutableHeld&) = delete;
};

void consumes_through_const() {
    ConstConsumed consumed;
    MutableHeld held;
    ConstConsumed const& consumed_view = consumed;
    MutableHeld const& held_view = held;
    auto drain = [&consumed_view] { return static_cast<ConstConsumed const&&>(consumed_view).consume(); };
    auto spend = [&held_view] { held_view.spent = 1; };
    static_cast<void>(drain());
    spend();
}

}  // namespace planted
