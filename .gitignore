# Binary artifacts
*.pdf
!papers/**/*.pdf

# Obsidian vault + Syncthing state. misc/ is a live Syncthing folder paired
# with the laptop, so Obsidian and Syncthing both drop metadata beside the
# tracked markdown. .stignore IS tracked: it is shared sync configuration.
misc/.obsidian/
misc/.stfolder/
misc/.stversions/
misc/.trash/
*.sync-conflict-*
