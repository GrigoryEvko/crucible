build/
build-*/
# The plants of a rule whose ID starts with build- are sources, such as the plants of the rule build-order.
!utils/plants/build-*/
pgo/
CMakeUserPresets.json
Testing/

# Editor files
*~
*.swp
*.swo
.vscode/

# Tool caches
.cache/
.playwright-mcp/
.claude/

# Git worktrees: git worktree add .worktrees/NAME. Each one holds a full copy
# of the sources and often a build directory. The guards list files with
# git ls-files --exclude-standard, so this line keeps those copies out of
# every scan.
.worktrees/

# `setup install` puts the pinned tools in the shared cache
# (tools_root() of utils/assay/core/cache.py), and no script writes .tools/. A checkout or an
# export can still hold a copy or a link of the tools there. The guards list
# files with git ls-files --exclude-standard, so this line keeps that copy out
# of every scan and out of every commit.
.tools

# Python bytecode
__pycache__/
*.pyc

# Binary artifacts
*.pdf
!papers/**/*.pdf

# Local venv holding the Crucible-patched PyTorch (vessel/torch tracing)
.venv-torch/

# Recorded traces. The record scripts in vessel/torch/examples write .crtrace
# files here. A trace is data from one run on one machine, not source.
traces/
