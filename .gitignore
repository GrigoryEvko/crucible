build/
build-*/
pgo/
CMakeUserPresets.json
Testing/

# Editor files
*~
*.swp
*.swo
.vscode/

# Tool caches
.cache/
.playwright-mcp/
.claude/

# Git worktrees: git worktree add .worktrees/NAME. Each one holds a full copy
# of the sources and often a build directory. The guards list files with
# git ls-files --exclude-standard, so this line keeps those copies out of
# every scan.
.worktrees/

# Pinned binary tools that the repo installs for itself. Crucible holds its own
# tree-sitter CLI and C++ grammar here rather than reach for one on the PATH,
# because a PATH binary is an unpinned input. utils/scripts/install-tree-sitter.sh
# fills this directory from a GitHub release, and it verifies the tarball
# against a hardcoded SHA256 before it unpacks anything. CI runs the same
# script, so the bytes match. The contents are large and platform-specific, so
# they never enter a commit.
.tools/

# Python bytecode
__pycache__/
*.pyc

# Binary artifacts
*.pdf
!papers/**/*.pdf

# Local venv holding the Crucible-patched PyTorch (vessel/torch tracing)
.venv-torch/

# Recorded traces. The record scripts in vessel/torch/examples write .crtrace
# files here. A trace is data from one run on one machine, not source.
traces/
