+#pragma once
+
+// Stash the Python callsite of a call that is about to leave Python for
+// ATen, so the Crucible recording kernel can attribute the operators of
+// that call to the line that made it.
+//
+// The pair it stores is (code object address, bytecode offset). Nothing
+// dereferences the address: the recording kernel hashes the pair into
+// the callsite column of the ring, and two calls made from one line
+// carry one pair. Resolving the pair back to a file and a line number is
+// a cold-path concern and needs the code object itself, which is why the
+// address is kept rather than a string.
+//
+// The GIL is the whole constraint on where this runs. PyEval_GetFrame()
+// reads the interpreter's frame stack, so the call has to sit ahead of
+// the pybind11::gil_scoped_release that every dispatch_* helper opens
+// with, while the caller's GIL is still held.
+
+#include <torch/csrc/python_headers.h>
+#include <torch/csrc/utils/pythoncapi_compat.h>
+
+#include <c10/core/CrucibleState.h>
+
+#include <cstdint>
+
+namespace torch::crucible {
+
+// Record the innermost Python frame into the Crucible TLS.
+//
+// Costs one thread-local read and one compare when Crucible is not
+// recording, which is every call of every process that does not opt in.
+// The frame walk happens only once the mode says somebody is listening.
+inline void stash_python_callsite() {
+  auto& state = c10::CrucibleState::get_tls_state();
+  if (state.mode() == c10::CrucibleMode::INACTIVE) {
+    return;
+  }
+  PyFrameObject* frame = PyEval_GetFrame();
+  if (frame == nullptr) {
+    // A call that reached ATen from C++ with no Python frame on the
+    // stack. Clear the pair rather than leave the previous callsite in
+    // place, which would attribute this operator to an unrelated line.
+    state.set_callsite(nullptr, -1);
+    return;
+  }
+  // PyFrame_GetCode returns a strong reference. The frame holds its own
+  // reference for as long as it runs, and it is running now, so the
+  // address stays valid over the call this pair describes.
+  PyCodeObject* code = PyFrame_GetCode(frame);
+  state.set_callsite(
+      static_cast<const void*>(code),
+      static_cast<int32_t>(PyFrame_GetLasti(frame)));
+  Py_DECREF(code);
+}
+
+} // namespace torch::crucible
